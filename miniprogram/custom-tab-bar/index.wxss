.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  min-height: 80rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: linear-gradient(135deg, var(--lxm-c-red, #EE2C2C) 0%, var(--lxm-c-orange, #FF8D52) 100%);
  border-top: 1rpx solid rgba(255, 247, 239, 0.28);
  box-shadow: 0 -4rpx 18rpx rgba(238, 44, 44, 0.28);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  transition: transform 0.18s ease, opacity 0.18s ease, filter 0.18s ease;
  opacity: 0.82;
}

.tab-item.is-active {
  transform: translateY(0);
  opacity: 1;
  filter: drop-shadow(0 2rpx 6rpx rgba(255, 255, 255, 0.45));
}

.tab-label {
  font-size: var(--lxm-fz-sm);
  line-height: 1;
  font-weight: var(--lxm-fw-semibold);
  color: var(--lxm-c-cream, #FFF7EF);
}

.tab-item.is-active .tab-label {
  font-weight: 700;
  color: var(--lxm-c-surface, #FFFFFF);
  text-shadow: 0 1rpx 8rpx rgba(255, 255, 255, 0.5);
}
