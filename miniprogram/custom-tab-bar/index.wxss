.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  min-height: 80rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--lxm-c-gray-50);
  border-top: 1rpx solid var(--lxm-c-line);
  box-shadow: 0 -6rpx 16rpx rgba(64,39,26,0.06);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  transition: transform 0.18s ease, opacity 0.18s ease;
  opacity: 1;
}

.tab-item.is-active {
  transform: translateY(0);
  opacity: 1;
}

.tab-label {
  font-size: var(--lxm-fz-sm);
  line-height: 1;
  font-weight: var(--lxm-fw-regular);
  color: var(--lxm-c-muted);
}

.tab-item.is-active .tab-label {
  font-weight: var(--lxm-fw-medium);
  color: var(--lxm-c-red-ink);
}
