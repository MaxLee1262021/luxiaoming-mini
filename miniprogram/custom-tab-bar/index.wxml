<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="index"
    class="tab-item {{selected === index ? 'is-active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <lxm-icon type="{{item.icon}}" size="22" color="white"></lxm-icon>
    <view class="tab-label">{{item.text}}</view>
  </view>
</view>
