.physical-page{min-height:100vh;background:#f8f3ed;color:#342b25;padding:24rpx 24rpx 180rpx;box-sizing:border-box}.physical-card{background:#fff;border:1rpx solid #eee6de;border-radius:26rpx;padding:28rpx;margin-bottom:22rpx}.physical-title{font-size:32rpx;font-weight:700;display:block}.physical-sub{display:block;color:#8c7c70;font-size:25rpx;line-height:1.7;margin-top:10rpx}.physical-price{color:#ee6231;font-size:32rpx;font-weight:700}.physical-row{display:flex;align-items:center;gap:20rpx}.physical-between{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.physical-grow{flex:1;min-width:0}.physical-cover{width:136rpx;height:136rpx;border-radius:16rpx;background:#f5eee6;flex-shrink:0}.physical-line{border-bottom:1rpx solid #f1e9e2;padding:22rpx 0}.physical-line:last-child{border-bottom:0}.physical-small{font-size:24rpx;color:#8c7c70}.physical-empty{text-align:center;padding:90rpx 20rpx}.physical-error{background:#fff0e8;color:#af4829;padding:22rpx;border-radius:18rpx;margin-bottom:20rpx}.physical-primary,.physical-secondary{font-size:28rpx;border-radius:48rpx;margin:0;line-height:82rpx;padding:0 30rpx;font-weight:600}.physical-primary{color:#fff;background:linear-gradient(100deg,#ed3030,#ff7b42)}.physical-secondary{background:#f6eee7;color:#765b46}.physical-primary::after,.physical-secondary::after{border:0}.physical-primary[disabled]{background:#dbcec3;color:#fff}.physical-footer{position:fixed;bottom:0;left:0;right:0;padding:20rpx 26rpx calc(20rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #eee5dc;z-index:30;display:flex;align-items:center;gap:20rpx}.physical-footer .physical-primary{flex:1}.physical-input{width:100%;box-sizing:border-box;font-size:28rpx;min-height:82rpx;border-bottom:1rpx solid #eee6de;padding:18rpx 0}.physical-label{font-size:25rpx;color:#8c7c70;display:block;margin-top:20rpx}.physical-stepper{display:flex;align-items:center;gap:16rpx}.physical-stepper button{width:58rpx;height:58rpx;line-height:54rpx;margin:0;padding:0;background:#f6eee7;color:#644c3a;border-radius:14rpx;font-size:30rpx}.physical-stepper input{width:66rpx;text-align:center;font-size:28rpx}.physical-link{color:#c4522f;font-size:26rpx;padding:14rpx 0}.physical-tags{display:flex;gap:14rpx;flex-wrap:wrap;margin:20rpx 0}.physical-tag{padding:16rpx 22rpx;background:#f5efe9;border:2rpx solid transparent;border-radius:14rpx;font-size:25rpx}.physical-tag.active{border-color:#ef653d;color:#c74d2d;background:#fff2e9}.physical-mask{position:fixed;inset:0;background:rgba(39,25,17,.4);z-index:90;display:flex;align-items:flex-end}.physical-sheet{background:#fff;border-radius:30rpx 30rpx 0 0;padding:32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));width:100%;box-sizing:border-box;max-height:85vh;overflow-y:auto}.physical-close{font-size:38rpx;color:#8b7d73;padding:0 18rpx}.physical-sheet .physical-primary{margin-top:26rpx}.physical-check{width:48rpx;flex-shrink:0;color:#bcb0a5;font-size:36rpx}.physical-check.selected{color:#ed6538}.physical-badge{color:#b94d2d;background:#fff0e4;border-radius:8rpx;padding:4rpx 12rpx;font-size:23rpx}.physical-timeline{border-left:2rpx solid #ecded1;padding:4rpx 0 28rpx 25rpx;margin-left:8rpx}.physical-actions{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:24rpx}.physical-actions button{font-size:25rpx;line-height:68rpx}.physical-error button{margin-top:16rpx}
