<view
  class="package-card {{variant === 'home' ? 'is-home' : ''}} {{layout === 'horizontal' ? 'is-horizontal' : ''}} {{selectable ? 'is-selectable' : ''}} {{selected ? 'is-selected' : ''}}"
  style="--pkg-cover-size: {{coverSize || (layout === 'horizontal' ? 180 : 224)}}rpx;"
  catchtap="onTap"
  hover-class="lxm-card-lift"
  hover-stay-time="150"
>
  <view class="card-img-wrap">
    <view class="card-type-badge badge-photo">旅拍套餐</view>
    <image
      src="{{item.cover || '/images/placeholder.png'}}"
      mode="aspectFill"
      class="card-cover"
      lazy-load
    />
    <view class="card-tags" wx:if="{{tags.length}}">
      <text class="tag" wx:for="{{tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
    </view>
  </view>

  <view class="card-body">
    <view class="card-title-row">
      <view class="card-title">{{item.name}}</view>
      <view class="card-badge" wx:if="{{badge}}">{{badge}}</view>
    </view>

    <!-- 套餐组合内容标签：自动读 includedItems 的 type，显示 照片 / 视频 / 周边（替换原规格行） -->
    <view class="card-compose" wx:if="{{compositionTags.length}}">
      <text class="compose-tag" wx:for="{{compositionTags}}" wx:for-item="ct" wx:key="*this">{{ct}}</text>
    </view>
    <text class="card-item-count" wx:if="{{itemCount}}">{{itemCount}} 件商品 · {{typeCount}} 种类型</text>

    <view class="card-desc" wx:if="{{variant !== 'home' && showDetails && description}}">{{description}}</view>

    <view class="card-selected-tag" wx:if="{{selectable && selected}}">已选</view>

    <view class="card-price-row">
      <view class="price-main">
        <text class="price-symbol">¥</text>
        <text class="price-value">{{item.price}}</text>
      </view>
    </view>

    <view class="price-original" wx:if="{{variant === 'home' || item.originalPrice}}">
      <text wx:if="{{item.originalPrice}}">原价 ¥{{item.originalPrice}}</text>
    </view>
  </view>
</view>
