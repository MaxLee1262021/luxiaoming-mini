/* 拍照写真/旅拍套餐卡片：单源组件
   支持 vertical（上图下文）/ horizontal（封面在左）两种布局，
   可选中（selectable）、自定义角标（badge）、可选内嵌视频（showVideo）。 */
.package-card {
  display: flex;
  flex-direction: column;
  height: auto;
  min-height: 480rpx;
  min-width: 0;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
  overflow: hidden;
  border-radius: var(--lxm-r-md);
  background: var(--lxm-c-surface);
  box-shadow: 0 14rpx 34rpx rgba(64, 39, 26, 0.10);
  border: 2rpx solid transparent;
}

.package-card:active {
  transform: scale(0.98);
}

/* 横版布局：封面在左，信息在右 */
.package-card.is-horizontal {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  height: auto;
  min-height: 0;
}

/* 可选中模式 */
.package-card.is-selectable {
  cursor: pointer;
}
.package-card.is-selected {
  border-color: var(--lxm-c-red);
  background: var(--lxm-c-gray-100);
}

.card-img-wrap {
  position: relative;
  width: 100%;
  height: var(--pkg-cover-size, 224rpx);
  overflow: hidden;
  background: var(--lxm-c-gray-500);
  flex-shrink: 0;
}

.package-card.is-horizontal .card-img-wrap {
  width: var(--pkg-cover-size, 180rpx);
  height: var(--pkg-cover-size, 180rpx);
}

/* 横版小封面不需要底部渐隐遮罩 */
.package-card.is-horizontal .card-img-wrap::after {
  display: none;
}

.card-cover {
  width: 100%;
  height: 100%;
}

.card-img-wrap::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 108rpx;
  background: linear-gradient(to top, rgba(42, 33, 27, 0.48), rgba(42, 33, 27, 0));
  pointer-events: none;
}

.card-type-badge {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  z-index: 2;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: var(--lxm-fz-xs);
  color: var(--lxm-c-surface);
  font-weight: 900;
}

.badge-photo,
.badge-video {
  background: var(--lxm-c-red);
}

.card-play {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 2;
  width: 62rpx;
  height: 62rpx;
  margin-left: -31rpx;
  margin-top: -31rpx;
  line-height: 62rpx;
  text-align: center;
  border-radius: 999rpx;
  background: rgba(255, 247, 239, 0.92);
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-sm);
  font-weight: 900;
}
.package-card.is-horizontal .card-play {
  width: 50rpx;
  height: 50rpx;
  margin-left: -25rpx;
  margin-top: -25rpx;
}

.card-body {
  display: flex;
  flex-direction: column;
  padding: 18rpx 18rpx 20rpx;
  flex: 1;
  min-width: 0;
  min-height: 0;
}
.package-card.is-horizontal .card-body {
  display: flex;
  flex-direction: column;
}

.card-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
  flex-wrap: wrap;
}

.card-title {
  display: block;
  min-height: auto;
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-md);
  font-weight: 900;
  line-height: 1.35;
  white-space: normal;
  min-width: 0;
  max-width: 100%;
}

.card-badge {
  flex-shrink: 0;
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  background: var(--lxm-c-gold);
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-2xs);
  font-weight: 900;
}

.card-selected-tag {
  align-self: flex-start;
  margin-top: 10rpx;
  padding: 3rpx 14rpx;
  border-radius: 999rpx;
  background: var(--lxm-c-red);
  color: var(--lxm-c-surface);
  font-size: var(--lxm-fz-2xs);
  font-weight: 900;
}

.card-tags {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  z-index: 3;
  max-width: calc(100% - 24rpx);
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 7rpx;
  overflow: hidden;
  pointer-events: none;
}

.tag {
  font-size: var(--lxm-fz-2xs);
  color: var(--lxm-c-cream);
  background: var(--lxm-c-red);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 900;
  max-width: 100%;
  box-sizing: border-box;
  white-space: normal;
  line-height: 1.5;
}

.package-card.is-horizontal .card-tags {
  right: 8rpx;
  bottom: 8rpx;
  max-width: calc(100% - 16rpx);
}

.package-card.is-horizontal .tag {
  padding: 5rpx 12rpx;
}

/* 套餐组合内容标签：照片 / 视频 / 周边（替换原规格行） */
.card-compose {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7rpx;
  margin-top: 10rpx;
  overflow: hidden;
}
.compose-tag {
  font-size: var(--lxm-fz-2xs);
  color: var(--lxm-c-red-ink);
  background: var(--lxm-c-orange-soft);
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 900;
  white-space: nowrap;
  flex-shrink: 0;
}

.card-desc {
  flex: 1 1 auto;
  min-height: 0;
  color: var(--lxm-c-gray-700);
  font-size: var(--lxm-fz-xs);
  line-height: 1.35;
  margin-top: 10rpx;
  white-space: normal;
}

.price-original {
  color: var(--lxm-c-muted);
  font-size: var(--lxm-fz-sm);
  text-decoration: line-through;
  margin-top: 8rpx;
}

.card-price-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: auto;
  padding-top: 12rpx;
  flex-wrap: wrap;
}
.package-card.is-horizontal .card-price-row {
  margin-top: auto;
}

.price-main {
  display: flex;
  align-items: baseline;
  min-width: 0;
  max-width: 100%;
  flex-wrap: wrap;
}

.price-symbol {
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-sm);
  font-weight: 900;
}

.price-value {
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-lg);
  font-weight: 900;
  margin: 0 3rpx;
}

.card-item-count {
  display: block;
  margin-top: 10rpx;
  color: var(--lxm-c-gray-700);
  font-size: var(--lxm-fz-xs);
  line-height: 1.5;
}

/* 首页宽 300rpx，正文净宽 260rpx：28rpx 字号每行约 9 字。
   三行标题占 28 × 1.35 × 3 = 113.4rpx；整卡定高并保留原价行。 */
.package-card.is-home {
  box-sizing: border-box;
  height: 560rpx;
  min-height: 560rpx;
}

.package-card.is-home .card-body {
  padding: 16rpx 18rpx 18rpx;
}

.package-card.is-home .card-title-row {
  display: block;
  height: 113.4rpx;
  flex: 0 0 113.4rpx;
  overflow: hidden;
}

.package-card.is-home .card-title {
  display: -webkit-box;
  height: 113.4rpx;
  line-height: 37.8rpx;
  overflow: hidden;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.package-card.is-home .card-compose,
.package-card.is-home .card-item-count,
.package-card.is-home .card-price-row,
.package-card.is-home .price-original {
  flex-shrink: 0;
}

.package-card.is-home .compose-tag,
.package-card.is-home .price-main {
  line-height: 1.2;
}

.package-card.is-home .card-item-count {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.package-card.is-home .price-original {
  height: 30rpx;
  line-height: 30rpx;
  white-space: nowrap;
}

@media (max-width: 360px) {
  .package-card.is-horizontal { flex-wrap: wrap; }
  .package-card.is-horizontal .card-img-wrap { width: 100%; height: 200rpx; }
  .package-card.is-horizontal .card-body { width: 100%; box-sizing: border-box; }
}
