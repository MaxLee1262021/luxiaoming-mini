/* 麓小鸣旅拍 · 统一图标库 lxm-icon
 * 线性描边风格，24x24 viewBox，与 lxm-empty-state 同源。
 * 通过 color 属性（ink/muted/red）选择配色变体，见 .c-* 类。
 * 用法：<lxm-icon type="home" size="26" color="muted"></lxm-icon>
 */

.lxm-icon {
  display: inline-block;
  width: 24rpx;
  height: 24rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  flex: none;
  vertical-align: middle;
}

