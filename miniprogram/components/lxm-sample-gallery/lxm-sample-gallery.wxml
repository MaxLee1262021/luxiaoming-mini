<view class="lxm-sample-gallery">
  <view class="lxm-sample-gallery__head" wx:if="{{title}}">
    <view class="lxm-sample-gallery__titles">
      <view class="lxm-sample-gallery__title">{{title}}</view>
      <view class="lxm-sample-gallery__subtitle" wx:if="{{subtitle}}">{{subtitle}}</view>
    </view>
    <view class="lxm-sample-gallery__count" wx:if="{{galleryUrls.length}}">{{galleryUrls.length}} 张</view>
  </view>

  <view class="lxm-sample-gallery__stage" wx:if="{{activeUrl}}" bindtap="onPreview">
    <image class="lxm-sample-gallery__stage-img" src="{{activeUrl}}" mode="aspectFill" lazy-load />
    <view class="lxm-sample-gallery__stage-mask">
      <text class="lxm-sample-gallery__stage-tip">点击全屏预览</text>
    </view>
  </view>

  <scroll-view wx:if="{{galleryUrls.length}}" class="lxm-sample-gallery__strip" scroll-x show-scrollbar="{{false}}">
    <view
      wx:for="{{galleryUrls}}"
      wx:key="*this"
      class="lxm-sample-gallery__thumb {{index === activeIndex ? 'is-active' : ''}}"
      data-index="{{index}}"
      bindtap="onThumbTap"
    >
      <image class="lxm-sample-gallery__thumb-img" src="{{item}}" mode="aspectFill" lazy-load />
    </view>
  </scroll-view>
</view>
