/* 自定义组件样式隔离，横滑容器在组件内声明，随最高卡片展开。 */
.video-product-scroll {
  height: auto;
  padding-left: 28rpx;
  white-space: nowrap;
}

.video-product-track {
  display: inline-flex;
  align-items: flex-start;
  padding-bottom: 12rpx;
  white-space: normal;
}

.lxm-related {
  margin: 36rpx 0;
}

.lxm-related-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 28rpx 22rpx;
}

.lxm-related-titles {
  min-width: 0;
}

.lxm-related-title {
  font-size: var(--lxm-fz-xl);
  font-weight: 900;
  color: var(--lxm-c-ink);
  line-height: 1.3;
}

.lxm-related-subtitle {
  margin-top: 6rpx;
  font-size: var(--lxm-fz-sm);
  color: var(--lxm-c-gray-650);
  line-height: 1.4;
}

.lxm-related-badge {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: var(--lxm-fz-xs);
  font-weight: 900;
}

.lxm-related-badge.blue {
  color: var(--lxm-c-gold-deep);
  background: rgba(154, 91, 11, 0.1);
}

.lxm-related-badge.red {
  color: var(--lxm-c-red-ink);
  background: rgba(238, 44, 44, 0.1);
}
