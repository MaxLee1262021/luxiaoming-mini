:host {
  display: inline-block;
  flex: 0 0 auto;
  vertical-align: top;
}

button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1 !important;
  text-align: center;
}

/* 短视频卡片统一组件：与详情页「相关推荐」大图卡片同款
   单品 = 奶油底红字标签；套餐 = 品牌橙填充标签 */
.video-card {
  position: relative;
  overflow: hidden;
  border-radius: 26rpx;
  background: var(--lxm-c-red);
  box-shadow: var(--lxm-shadow-red-strong);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.video-card:active {
  transform: scale(0.985);
}

/* product 模式：横向滚动大卡片（首页/搜索/短视频页/相关推荐） */
.video-card.product {
  display: inline-block;
  width: 560rpx;
  max-width: calc(100vw - 48rpx);
  height: auto;
  margin-right: 18rpx;
  vertical-align: top;
}

.video-cover-wrap {
  position: relative;
  width: 100%;
  height: 250rpx;
  overflow: hidden;
  background: var(--lxm-c-ink);
}

.video-player {
  width: 100%;
  height: 100%;
  display: block;
}

.video-unavailable {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: var(--lxm-c-cream);
  font-size: var(--lxm-fz-sm);
}

.video-error {
  position: absolute;
  inset: 0;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: var(--lxm-c-ink);
  color: var(--lxm-c-cream);
  font-size: var(--lxm-fz-sm);
}

.video-retry {
  margin: 0;
  min-width: 128rpx;
  min-height: 72rpx;
  border-radius: 999rpx;
  background: var(--lxm-c-cream);
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-sm);
}

.video-copy {
  position: relative;
  padding: 22rpx 24rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  min-width: 0;
  background: var(--lxm-c-ink);
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.video-tag {
  width: fit-content;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 241, 231, 0.92);
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-2xs);
  font-weight: 900;
  max-width: 100%;
  box-sizing: border-box;
  white-space: normal;
}

.video-labels {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.video-title {
  display: block;
  margin-top: 12rpx;
  color: var(--lxm-c-surface);
  font-size: var(--lxm-fz-lg);
  font-weight: 900;
  line-height: 1.2;
  white-space: normal;
}

.video-meta {
  display: block;
  margin-top: 9rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: var(--lxm-fz-sm);
  white-space: normal;
}

.video-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.video-detail {
  flex-shrink: 0;
  gap: 12rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid rgba(255, 247, 239, 0.32);
  border-radius: 999rpx;
  background: rgba(255, 247, 239, 0.08);
  color: var(--lxm-c-cream);
  font-size: var(--lxm-fz-sm);
  font-weight: var(--lxm-fw-semibold);
}

.video-detail::after { border: 0; }
.video-detail-arrow { font-size: var(--lxm-fz-xl); font-weight: var(--lxm-fw-regular); }

.video-price {
  max-width: 100%;
  color: var(--lxm-c-gold);
  font-size: var(--lxm-fz-xl);
  font-weight: 900;
}

.video-book {
  position: relative;
  min-height: 72rpx;
  height: auto;
  line-height: 1.4 !important;
  margin: 14rpx 0 0;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-sm);
  font-weight: 900;
}

/* 无障碍：视觉不变，透明热区高度扩至 88rpx（WCAG 2.5.5） */
.video-book::after {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
  height: 88rpx;
  border: 0;
}

/* 套餐卡变体：角标用品牌橙填充，与单品卡明显区分 */
.video-card.is-package .video-tag {
  background: var(--lxm-c-orange);
  color: var(--lxm-c-cream);
}

/* grid 模式：整宽块级（保留给未来网格场景） */
.video-card.grid {
  display: block;
  width: 100%;
  height: auto;
  margin-right: 0;
}

.video-marketing-badge {
  max-width: 100%;
  box-sizing: border-box;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  font-size: var(--lxm-fz-2xs);
  font-weight: 900;
  background: var(--lxm-c-gold);
  color: var(--lxm-c-ink);
  pointer-events: none;
}
