.empty-icon.error {
  background-color: var(--lxm-c-error-bg);
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20viewBox%3D%270%200%2024%2024%27%20fill%3D%27none%27%20stroke%3D%27%23EE2C2C%27%20stroke-width%3D%271.8%27%20stroke-linecap%3D%27round%27%20stroke-linejoin%3D%27round%27%3E%3Cpath%20d%3D%27M12%204l9%2016H3z%27%2F%3E%3Cpath%20d%3D%27M12%2010v4%27%2F%3E%3Cpath%20d%3D%27M12%2017v.5%27%2F%3E%3C%2Fsvg%3E");
  background-size: 46rpx 46rpx;
  background-position: center;
  background-repeat: no-repeat;
  box-shadow: none;
}

.empty-title {
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-lg);
  font-weight: 900;
}

.empty-desc {
  margin-top: 10rpx;
  color: var(--lxm-c-muted);
  font-size: var(--lxm-fz-sm);
  line-height: 1.5;
}

.empty-actions {
  display: flex;
  justify-content: center;
  gap: 18rpx;
  margin-top: 28rpx;
}

.empty-btn {
  position: relative;
  width: 220rpx;
  height: 68rpx;
  line-height: 68rpx;
  margin: 0;
  border-radius: var(--lxm-r-pill);
  background: var(--lxm-c-surface);
  color: var(--lxm-c-red-ink);
  border: 2rpx solid var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-sm);
  font-weight: 900;
}

.empty-btn.primary {
  background: var(--lxm-gradient-primary);
  color: var(--lxm-c-surface);
  border: none;
}

/* 无障碍：视觉不变，透明热区高度扩至 88rpx（WCAG 2.5.5） */
.empty-btn::after {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
  height: 88rpx;
  border: 0;
}
