button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1 !important;
  text-align: center;
}

.empty-state {
  margin: var(--lxm-s-3);
  padding: 60rpx 30rpx;
  border-radius: var(--lxm-r-lg);
  background: rgba(255,255,255,0.80);
  box-shadow: var(--lxm-shadow-card);
  text-align: center;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 22rpx;
  border-radius: 50%;
  background: var(--lxm-gradient-primary);
  box-shadow: var(--lxm-shadow-red);
  background-size: 46rpx 46rpx, cover;
  background-position: center, center;
  background-repeat: no-repeat;
}

