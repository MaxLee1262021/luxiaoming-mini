<view class="empty-state">
  <view class="empty-icon {{type}}"></view>
  <view class="empty-title">{{title}}</view>
  <view class="empty-desc" wx:if="{{desc}}">{{desc}}</view>
  <view class="empty-actions" wx:if="{{buttonText || secondaryText}}">
    <button class="empty-btn primary" wx:if="{{buttonText}}" bindtap="onAction">{{buttonText}}</button>
    <button class="empty-btn" wx:if="{{secondaryText}}" bindtap="onSecondary">{{secondaryText}}</button>
  </view>
</view>
