<view class="album-card {{mode}} {{selected ? 'is-selected' : ''}}" catchtap="onTap" hover-class="lxm-card-lift" hover-stay-time="150">
  <view class="album-cover-tags {{coverTags.length > 1 ? 'album-cover-tags--multiple' : ''}}" wx:if="{{coverTags.length && mode !== 'row'}}">
    <text class="album-marketing-badge">{{coverTagText}}</text>
  </view>

  <!-- 覆盖式：网格 / 横向滚动小卡 -->
  <block wx:if="{{mode === 'grid' || mode === 'compact'}}">
    <view class="album-media">
      <image class="album-cover" src="{{album.cover || album.coverImage || '/images/placeholder.png'}}" mode="aspectFill" lazy-load />
      <view class="album-mask"></view>
      <text class="album-type">照片留影</text>
      <view class="album-info">
        <text class="album-name">{{album.name || album.albumName}}</text>
        <text class="album-meta" wx:if="{{album.seriesName}}">{{album.seriesName}}</text>
        <view class="album-bottom {{photoCountBelowCover ? 'album-bottom--price-only' : ''}}">
          <text class="album-count" wx:if="{{!photoCountBelowCover}}">{{album.photoCountText}}</text>
          <text class="album-price" wx:if="{{album.price !== undefined && album.price !== ''}}">¥{{album.price}}</text>
        </view>
        <view class="album-actions" wx:if="{{showPreview || showBook || album.showBook}}">
          <button class="album-btn ghost" wx:if="{{showPreview}}" catchtap="onPreview">快速预览</button>
          <button class="album-btn primary" wx:if="{{showBook || album.showBook}}" catchtap="onBook">预约同款</button>
        </view>
      </view>
    </view>
    <view class="album-photo-description" wx:if="{{photoCountBelowCover}}">
      <text class="album-photo-description__text">{{album.photoCountText}}</text>
    </view>
    <view class="album-configured-tags" wx:if="{{coverTags.length > 1}}">
      <text class="album-configured-tag" wx:for="{{coverTags}}" wx:key="*this">{{item}}</text>
    </view>
  </block>

  <!-- 横排列表行：封面在左 + 信息 + 右侧胶囊（吸收 spot mini-collection-card） -->
  <block wx:elif="{{mode === 'row'}}">
    <image class="album-cover row-cover" style="width:{{coverSize || 96}}rpx;height:{{coverSize || 96}}rpx" src="{{album.cover || album.coverImage || '/images/placeholder.png'}}" mode="aspectFill" lazy-load />
    <view class="album-row-info">
      <text class="album-row-title">{{album.name || album.albumName || album.title}}</text>
      <text class="album-row-meta">{{album.meta || (album.photoCountText + (album.price !== undefined && album.price !== '' ? ' · ¥' + album.price : ''))}}</text>
    </view>
    <view class="album-row-tail" wx:if="{{ctaText}}">
      <text class="album-cta">{{ctaText}}</text>
    </view>
  </block>

  <!-- 竖版产品卡：封面在上 + 信息在下 + 预约按钮（吸收 photoCollection collection-card） -->
  <block wx:elif="{{mode === 'stack'}}">
    <image class="album-cover stack-cover" style="height:{{coverSize || 330}}rpx" src="{{album.cover || album.coverImage || '/images/placeholder.png'}}" mode="aspectFill" lazy-load />
    <view class="album-stack-info">
      <view wx:if="{{selected}}" class="album-focus-badge">刚刚查看</view>
      <text class="album-stack-title">{{album.name || album.albumName || album.seriesName}}</text>
      <text class="album-stack-series" wx:if="{{album.seriesName}}">{{album.seriesName}}</text>
      <text class="album-stack-desc" wx:if="{{album.intro || album.desc || album.description}}">{{album.intro || album.desc || album.description}}</text>
      <view class="album-configured-tags album-configured-tags--inline" wx:if="{{coverTags.length > 1}}">
        <text class="album-configured-tag" wx:for="{{coverTags}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="album-stack-meta">
        <text class="album-tag">{{album.photoCountText}}</text>
        <text class="album-tag ghost">看九宫格</text>
      </view>
      <view class="album-stack-foot">
        <text class="album-stack-price">¥{{album.price || 0}}</text>
        <button wx:if="{{showBook || album.showBook}}" class="album-btn primary" catchtap="onBook">预约同款</button>
      </view>
    </view>
  </block>

</view>
