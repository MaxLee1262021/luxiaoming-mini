<view class="lxm-cbc" bindtap="onTap" hover-class="lxm-cbc--hover" hover-stay-time="80">
  <view wx:if="{{context}}" class="lxm-cbc__ctx">{{context}}</view>
  <view class="lxm-cbc__banner">
    <text class="lxm-cbc__title">{{title}}</text>
    <text class="lxm-cbc__sub">{{subtitle}}</text>
  </view>
  <view class="lxm-cbc__body">
    <view class="lxm-cbc__price">
      <view class="lxm-cbc__price-main">{{priceMain}}<text class="lxm-cbc__price-unit">/小时</text></view>
      <view class="lxm-cbc__price-add">{{priceAdd}}</view>
    </view>
    <view class="lxm-cbc__note">提交需求后，鹿小鸣客服会通过企业微信与你确认档期与风格</view>
    <view class="lxm-cbc__btn" role="button" aria-label="{{buttonText}}">
      <text>{{buttonText}}</text>
      <lxm-icon type="arrow-right" size="18" color="white"></lxm-icon>
    </view>
  </view>
</view>
