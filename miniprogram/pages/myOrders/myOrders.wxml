<view class="my-orders-page">
  <lxm-nav-bar title="我的订单" showBack="{{true}}" placeholder="{{true}}" theme="light" />
  <lxm-privacy-modal />
  <lxm-toast id="lxmToast" />

  <view class="order-type-tabs"><view class="{{orderType === 'service' ? 'selected' : ''}}" data-type="service" bindtap="switchType">服务订单</view><view class="{{orderType === 'physical' ? 'selected' : ''}}" data-type="physical" bindtap="switchType">周边商品订单</view></view>
  <view class="tabs">
    <block wx:for="{{tabs}}" wx:key="key">
      <view class="tab-item {{currentStatus === item.key ? 'active' : ''}}" bindtap="filterOrders" data-status="{{item.key}}">
        {{item.text}}
      </view>
    </block>
  </view>

  <scroll-view class="order-list" scroll-y enable-back-to-top bindscrolltolower="onReachBottom" refresher-enabled bindrefresherrefresh="onRefresh" refresher-triggered="{{refreshing}}">
    <view wx:if="{{error}}" class="order-error">
      <view>{{error}}</view>
      <button class="order-error-btn" bindtap="onRetryLoad">重新加载</button>
    </view>
    <block wx:if="{{loading && orders.length === 0}}">
      <view class="lxm-skeleton-card" wx:for="{{[1,2,3,4]}}" wx:key="*this">
        <view class="lxm-skeleton lxm-skeleton-cover"></view>
        <view class="lxm-skeleton-body">
          <view class="lxm-skeleton lxm-skeleton-line sk-title"></view>
          <view class="lxm-skeleton lxm-skeleton-line sk-block"></view>
          <view class="lxm-skeleton lxm-skeleton-line sk-short"></view>
        </view>
      </view>
    </block>

    <block wx:for="{{orders}}" wx:key="_id">
      <lxm-order-card
        item="{{item}}"
        bind:contact="contactService"
        bind:detail="goDetail"
        bind:reschedule="openReschedule"
        bind:refund="openRefund"
        bind:cancel="openCancel"
      />
    </block>

    <lxm-empty-state
      wx:if="{{!loading && !error && orders.length === 0}}"
      type="order"
      title="暂无相关订单"
      desc="{{orderType === 'physical' ? '挑选喜欢的影像周边，把旅行的记忆带回家。' : '可以先看看旅拍套餐，选好打卡点、照片留影或视频摄像产品后再提交预约。'}}"
      button-text="{{orderType === 'physical' ? '去逛周边' : '看打卡点'}}"
      secondary-text="回首页"
      bind:action="goAllPackages"
      bind:secondary="goHome"
    />

    <view class="loading-more" wx:if="{{loading && orders.length > 0}}">加载中...</view>
  </scroll-view>
  <lxm-order-actions item="{{actionOrder}}" action="{{orderAction}}" bind:updated="onOrderActionUpdated" bind:close="closeOrderAction" />

</view>
