.my-orders-page {
  min-height: 100vh;
  background: var(--lxm-c-bg);
  color: var(--lxm-c-ink);
  display: flex;
  flex-direction: column;
}

.orders-hero {
  flex-shrink: 0;
  padding: 118rpx 30rpx 42rpx;
  color: var(--lxm-c-cream);
  background: linear-gradient(145deg, var(--lxm-c-ink) 0%, var(--lxm-c-red-press) 58%, var(--lxm-c-orange) 100%);
}

.orders-kicker,
.orders-title {
  display: block;
}

.orders-kicker {
  color: rgba(255,247,239,0.62);
  font-size: var(--lxm-fz-2xs);
  font-weight: 900;
}

.orders-title {
  margin-top: 10rpx;
  font-size: var(--lxm-fz-3xl);
  font-weight: 900;
  line-height: 1.1;
}

.tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  margin: -22rpx 20rpx 0;
  padding: 8rpx;
  border-radius: var(--lxm-r-md);
  background: rgba(255,253,249,0.96);
  box-shadow: 0 16rpx 36rpx rgba(64,39,26,0.10);
  overflow-x: auto;
  overflow-y: visible;
  white-space: nowrap;
}

.tab-item {
  position: relative;
  flex: 1 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 56rpx;
  padding: 0 2rpx;
  border-radius: 999rpx;
  text-align: center;
  color: var(--lxm-c-gray-700);
  font-size: var(--lxm-fz-2xs);
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
  box-sizing: border-box;
}

/* 无障碍：视觉不变，透明热区高度扩至 88rpx（WCAG 2.5.5） */
.tab-item::after {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
  height: 88rpx;
  border: 0;
}

.tab-item.active {
  background: linear-gradient(135deg, var(--lxm-c-ink), var(--lxm-c-gray-850));
  color: var(--lxm-c-cream);
}

.order-list {
  flex: 1;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

.order-error {
  margin: 48rpx 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  background: var(--lxm-c-surface);
  color: var(--lxm-c-gray-700);
  text-align: center;
}

.order-error-btn {
  margin-top: 20rpx;
  border-radius: 999rpx;
  background: var(--lxm-c-ink);
  color: var(--lxm-c-cream);
}

.loading-more {
  padding: 22rpx 0;
  color: var(--lxm-c-muted);
  font-size: var(--lxm-fz-sm);
  text-align: center;
}

.after-sale-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  display: flex;
  align-items: flex-end;
  background: rgba(42,33,27,0.42);
}

.after-sale-panel {
  width: 100%;
  padding: 30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: var(--lxm-c-gray-50);
  box-sizing: border-box;
  box-shadow: 0 -18rpx 46rpx rgba(42,33,27,0.18);
}

.after-sale-hd {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.after-sale-title {
  display: block;
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-lg);
  font-weight: 900;
}

.after-sale-subtitle {
  display: block;
  max-width: 560rpx;
  margin-top: 8rpx;
  color: var(--lxm-c-gray-700);
  font-size: var(--lxm-fz-sm);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.after-sale-close {
  position: relative;
  width: 58rpx;
  height: 58rpx;
  line-height: 54rpx;
  border-radius: 50%;
  background: var(--lxm-c-bg);
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-2xl);
  font-weight: var(--lxm-fw-semibold);
  text-align: center;
}

/* 无障碍：视觉不变，透明热区扩至 88rpx（WCAG 2.5.5） */
.after-sale-close::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 88rpx;
  height: 88rpx;
  border: 0;
  border-radius: inherit;
}

.after-sale-textarea {
  width: 100%;
  height: 220rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: var(--lxm-c-gray-150);
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-base);
  line-height: 1.5;
  box-sizing: border-box;
}

.after-sale-tips {
  margin-top: 16rpx;
  color: var(--lxm-c-gray-650);
  font-size: var(--lxm-fz-sm);
  line-height: 1.45;
}

.after-sale-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
}

.after-sale-cancel,
.after-sale-submit {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  border-radius: 999rpx;
  font-size: var(--lxm-fz-md);
  font-weight: 900;
}

.after-sale-cancel {
  background: var(--lxm-c-surface);
  color: var(--lxm-c-red-ink);
  border: 2rpx solid var(--lxm-c-gray-450);
}

.after-sale-submit {
  background: var(--lxm-gradient-primary);
  color: var(--lxm-c-surface);
  box-shadow: var(--lxm-shadow-red);
}

.after-sale-cancel::after,
.after-sale-submit::after {
  border: 0;
}
