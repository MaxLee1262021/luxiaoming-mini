/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  padding-bottom: 128rpx;
  background: var(--lxm-c-cream);
  color: var(--lxm-c-ink);
}

.home-top {
  position: sticky;
  top: 0;
  z-index: 30;
  padding: var(--nav-top, 26px) 28rpx 8rpx;
  background: var(--lxm-c-cream);
  transition: box-shadow 0.2s ease;
}

.home-top.compact {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: var(--nav-top, 26px) calc(var(--capsule-safe-right, 104px) + 8rpx) 10rpx 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(42,33,27,0.05);
}

/* 展开态品牌行（吸顶态隐藏，改用迷你 logo） */
.brand-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
  padding-right: var(--capsule-safe-right, 104px);
  transition: opacity 0.2s ease, margin 0.2s ease;
}

.home-top.compact .brand-header {
  display: none;
}

.brand-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.brand-logo {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, var(--lxm-c-orange) 0%, var(--lxm-c-red) 100%);
  color: var(--lxm-c-cream);
  text-align: center;
  font-size: var(--lxm-fz-base);
  font-weight: 900;
  box-shadow: 0 6rpx 16rpx rgba(42,33,27,0.10);
}

.home-top.compact .brand-logo {
  display: none;
}

.brand-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.brand-name {
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-md);
  font-weight: 900;
  line-height: 1.12;
}

/* 吸顶态迷你 logo（展开态隐藏） */
.mini-logo {
  display: none;
  width: 38rpx;
  height: 38rpx;
  line-height: 38rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, var(--lxm-c-orange) 0%, var(--lxm-c-red) 100%);
  color: var(--lxm-c-cream);
  text-align: center;
  font-size: var(--lxm-fz-xs);
  font-weight: 900;
  flex-shrink: 0;
}

.home-top.compact .mini-logo {
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-entry {
  height: 72rpx;
  padding: 0 10rpx 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.92);
  display: flex;
  align-items: center;
  box-shadow: 0 16rpx 34rpx rgba(238,44,44,0.10);
  border: 2rpx solid transparent;
  animation: searchBreath 2.8s ease-in-out infinite;
  transition: height 0.2s ease, padding 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.search-entry.focused {
  border-color: var(--lxm-c-red);
  box-shadow: 0 18rpx 42rpx rgba(238,44,44,0.20);
}

.home-top.compact .search-entry {
  flex: 1;
  min-width: 0;
  height: 62rpx;
  padding: 0 14rpx 0 18rpx;
}

.search-entry:active,
.feature-card:active,
.spot-card:active {
  transform: scale(0.98);
}

.search-icon {
  margin-right: 12rpx;
  color: var(--lxm-c-red);
  font-size: var(--lxm-fz-lg);
  font-weight: 900;
  transition: transform 0.2s ease, filter 0.2s ease;
}

.search-entry.focused .search-icon {
  transform: scale(1.1);
  filter: brightness(1.15);
}

.home-top.compact .search-icon {
  font-size: var(--lxm-fz-md);
}

.search-keyword-wrap {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.search-input {
  width: 100%;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-base);
  background: transparent;
}

.home-top.compact .search-input {
  height: 62rpx;
  min-height: 62rpx;
  line-height: 62rpx;
  font-size: var(--lxm-fz-sm);
}

.search-placeholder {
  color: var(--lxm-c-gray-700);
}

.search-clear {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: rgba(42,33,27,0.22);
  transition: transform 0.15s ease, background 0.15s ease;
}

/* 触摸热区扩展到 88rpx（44px @375 宽屏），满足无障碍触达标准，视觉大小不变 */
.search-clear::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 88rpx;
  height: 88rpx;
  transform: translate(-50%, -50%);
}

.search-clear:active {
  transform: scale(0.92);
  background: rgba(42,33,27,0.32);
}

.home-top.compact .search-clear {
  width: 42rpx;
  height: 42rpx;
  margin-right: 8rpx;
}

.search-action {
  padding: 9rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--lxm-c-red) 0%, var(--lxm-c-orange) 100%);
  color: var(--lxm-c-cream);
  font-size: var(--lxm-fz-sm);
  font-weight: 900;
  transition: transform 0.15s ease, filter 0.2s ease, box-shadow 0.2s ease;
}

.search-action:active {
  transform: scale(0.95);
  filter: brightness(1.08);
}

.search-action.has-keyword {
  box-shadow: 0 6rpx 16rpx rgba(238,44,44,0.28);
}

.home-top.compact .search-action {
  display: none;
}

.home-top.compact .search-clear {
  margin-right: 0;
}

@keyframes searchBreath {
  0%, 100% {
    box-shadow: 0 16rpx 34rpx rgba(238,44,44,0.10);
  }
  50% {
    box-shadow: 0 18rpx 42rpx rgba(238,44,44,0.18);
  }
}


.banner-wrap {
  position: relative;
  margin: 10rpx 28rpx 18rpx;
  border-radius: 26rpx;
  overflow: hidden;
  box-shadow: 0 22rpx 46rpx rgba(64,39,26,0.16);
}

.banner-swiper {
  height: 432rpx;
}

.banner-img,
.banner-video {
  width: 100%;
  height: 100%;
}

.banner-click-area {
  width: 100%;
  height: 100%;
}

.banner-copy {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 52rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  color: var(--lxm-c-surface);
  text-shadow: 0 4rpx 16rpx rgba(0,0,0,0.34);
}

.banner-copy::before {
  content: "";
  position: absolute;
  left: -30rpx;
  right: -30rpx;
  bottom: -52rpx;
  height: 220rpx;
  z-index: -1;
  background: linear-gradient(to top, rgba(0,0,0,0.62), transparent);
}

.banner-kicker {
  width: fit-content;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.20);
  font-size: var(--lxm-fz-xs);
  font-weight: 900;
}

.banner-title {
  margin-top: 14rpx;
  font-size: var(--lxm-fz-2xl);
  font-weight: 900;
  line-height: 1.18;
}

.banner-subtitle {
  margin-top: 10rpx;
  font-size: var(--lxm-fz-sm);
  color: rgba(255,255,255,0.86);
}

.banner-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 18rpx;
  z-index: 3;
  display: flex;
  justify-content: center;
  gap: 8rpx;
}

.banner-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.68);
}

.banner-dot.active {
  width: 28rpx;
  background: var(--lxm-c-orange);
}

/* .booking-strip 背景/边距/阴影统一由 .lxm-panel 提供，子元素样式保持不变 */

.strip-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 28rpx 16rpx;
}

.strip-title {
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-lg);
  font-weight: 900;
}

.strip-sub {
  margin-left: 12rpx;
  color: var(--lxm-c-orange-ink);
  font-size: var(--lxm-fz-xs);
  font-weight: var(--lxm-fw-semibold);
  vertical-align: middle;
}

.strip-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-sm);
  font-weight: 900;
}

.strip-scroll {
  padding-left: 28rpx;
  white-space: nowrap;
}

/* 列表为空时的占位提示（静态样式从 wxml 内联抽到此处，动态 style 仍保留内联） */
.strip-empty {
  padding: 28rpx 24rpx;
  color: var(--lxm-c-gray-650);
  font-size: 26rpx;
}

.strip-empty-link {
  color: var(--lxm-c-red-ink);
  font-weight: var(--lxm-fw-semibold);
}

/* .strip-card 已单源化为组件 lxm-album-card（mode=compact） */


.section,
.feature-zone {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 0 30rpx;
  margin-bottom: 16rpx;
}

.section-header.compact {
  align-items: flex-start;
}

.section-title {
  display: block;
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-lg);
  font-weight: 900;
  line-height: 1.25;
}



.section-more {
  position: relative;
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-sm);
  font-weight: 900;
  flex-shrink: 0;
}

/* 无障碍：透明热区扩至 88rpx（WCAG 2.5.5） */
.section-more::after {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
  height: 88rpx;
}

.section-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.feature-row {
  display: grid;
  grid-template-columns: 1.16fr 0.92fr;
  gap: 14rpx;
  padding: 0 28rpx;
}

.feature-card {
  min-height: 154rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.inspiration-feature {
  background:
    radial-gradient(circle at 18% 18%, rgba(255,180,95,0.34), rgba(255,180,95,0) 42%),
    linear-gradient(145deg, var(--lxm-c-red) 0%, var(--lxm-c-orange) 100%);
  color: var(--lxm-c-cream);
}

.goods-feature {
  background: linear-gradient(145deg, var(--lxm-c-surface) 0%, var(--lxm-c-gray-250) 100%);
}

.feature-kicker {
  color: rgba(238,44,44,0.62);
  font-size: var(--lxm-fz-2xs);
  font-weight: 900;
}

.inspiration-feature .feature-kicker {
  color: rgba(255,247,239,0.58);
}

.feature-name {
  margin-top: 12rpx;
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-md);
  font-weight: 900;
}

.inspiration-feature .feature-name {
  color: var(--lxm-c-surface);
  font-size: var(--lxm-fz-xl);
}

.feature-desc {
  margin-top: 10rpx;
  color: var(--lxm-c-gray-700);
  font-size: var(--lxm-fz-xs);
  line-height: 1.45;
}

.inspiration-feature .feature-desc {
  color: rgba(255,247,239,0.78);
  font-size: var(--lxm-fz-sm);
}

.feature-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-top: 18rpx;
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-sm);
  font-weight: 900;
}

.inspiration-feature .feature-link {
  color: var(--lxm-c-orange);
}

/* ===== 特色专区 · 地图探点横幅 ===== */
.map-banner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 192rpx;
  margin: 0 28rpx 14rpx;
  padding: 26rpx 28rpx;
  border-radius: var(--lxm-r-lg);
  overflow: hidden;
  background: linear-gradient(145deg, var(--lxm-c-cream) 0%, var(--lxm-c-gray-250) 100%);
  border: 1rpx solid var(--lxm-c-line-soft);
  box-shadow: var(--lxm-shadow-card);
}

.map-banner--hover {
  transform: scale(0.985);
}

.map-banner-text {
  position: relative;
  z-index: 1;
  min-width: 0;
}

.map-banner-title {
  display: block;
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-xl);
  font-weight: 900;
  line-height: 1.2;
}

.map-banner-sub {
  display: block;
  margin-top: 6rpx;
  color: var(--lxm-c-orange);
  font-size: var(--lxm-fz-2xs);
  font-weight: 900;
}

.map-banner-go {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--lxm-r-pill);
  background: rgba(238, 44, 44, 0.08);
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-sm);
  font-weight: 900;
}

.map-banner-map {
  position: relative;
  flex: 0 0 auto;
  width: 260rpx;
  height: 148rpx;
  margin-left: 16rpx;
  border-radius: var(--lxm-r-md);
  overflow: hidden;
  background:
    repeating-linear-gradient(0deg, rgba(42, 33, 27, 0.06) 0 1px, transparent 1px 20rpx),
    repeating-linear-gradient(90deg, rgba(42, 33, 27, 0.06) 0 1px, transparent 1px 20rpx),
    var(--lxm-c-gray-250);
}

.road {
  position: absolute;
  background: rgba(42, 33, 27, 0.10);
}

.road.h {
  left: -4%;
  right: -4%;
  height: 10rpx;
}

.road.v {
  top: -4%;
  bottom: -4%;
  width: 10rpx;
}

.pin {
  position: absolute;
  transform: translate(-50%, -100%);
  width: 24rpx;
  height: 24rpx;
  border-radius: 50% 50% 50% 0;
  background: var(--lxm-c-red);
  box-shadow: 0 2rpx 5rpx rgba(42, 33, 27, 0.22);
}

.pin.hollow {
  background: transparent;
  border: 2rpx dashed var(--lxm-c-orange);
}

/* 通用横向滚动容器（商品/套餐卡） */
.package-scroll {
  padding-left: 28rpx;
  white-space: nowrap;
}

/* 套餐卡横向滚动：直接命中 lxm-package-card，统一 320rpx 宽（与探索页一致，修复截断） */
.package-scroll lxm-package-card {
  display: inline-block;
  width: 320rpx;
  height: 540rpx;
  flex: 0 0 auto;
  margin-right: 20rpx;
  vertical-align: top;
}

.video-product-section {
  padding: 8rpx 0 2rpx;
}

.video-product-scroll {
  padding-left: 28rpx;
  white-space: nowrap;
}

.pkg-scroll-item {
  display: inline-block;
  width: 320rpx;
  margin-right: 18rpx;
  vertical-align: top;
}

/* ===== 首页打卡点热榜（方案 B：排名卡横滑，去「全部」，默认选中第 1 名） ===== */
.spot-tabs {
  padding: 18rpx 0 10rpx;
}
.spot-tabs-head {
  display: flex;
  align-items: baseline;
  padding: 0 24rpx 12rpx;
}
.spot-tabs-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--lxm-c-ink, #2A211B);
  letter-spacing: 1rpx;
}
.spot-tabs-tip {
  margin-left: 12rpx;
  font-size: var(--lxm-fz-2xs);
  color: var(--lxm-c-gray-650, #9a8f80);
  font-weight: 600;
}
.spot-tabs-scroll {
  width: 100%;
  white-space: nowrap;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.rank-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 132rpx;
  padding: 18rpx 0 16rpx;
  margin-right: 18rpx;
  border-radius: 20rpx;
  background: var(--lxm-c-surface, #FFFFFF);
  border: 1rpx solid rgba(42, 33, 27, 0.08);
  box-shadow: 0 4rpx 12rpx rgba(42, 33, 27, 0.05);
  box-sizing: border-box;
  vertical-align: top;
  transition: transform .12s ease, box-shadow .2s ease, border-color .2s ease;
}
.rank-card:active {
  transform: scale(0.96);
}
.rank-num {
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--lxm-c-gray-550, #C8BDB5);
  margin-bottom: 10rpx;
}
.rank-num.r1 { color: var(--lxm-c-gold-deep, #9A5B0B); }
.rank-num.r2 { color: var(--lxm-c-gray-650, #9C877A); }
.rank-num.r3 { color: var(--lxm-c-orange-press, #EE5B35); }
.rank-cover {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background: var(--lxm-c-gray-250, #F3EDE4);
  margin-bottom: 10rpx;
}
.rank-cover--ph {
  background: radial-gradient(120% 120% at 0 0, rgba(238, 44, 44, 0.14), transparent 60%), var(--lxm-c-gray-250, #F3EDE4);
}
.rank-name {
  font-size: 24rpx;
  font-weight: var(--lxm-fw-semibold, 600);
  color: var(--lxm-c-ink, #2A211B);
  line-height: 1.2;
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.rank-card.on {
  border-color: transparent;
  background: linear-gradient(135deg, var(--lxm-c-red, #EE2C2C) 0%, var(--lxm-c-orange, #FF8D52) 100%);
  box-shadow: 0 8rpx 18rpx rgba(238, 44, 44, 0.22);
}
.rank-card.on .rank-name {
  color: var(--lxm-c-cream, #FFF7EF);
}
.rank-card.on .rank-cover {
  box-shadow: 0 0 0 2rpx rgba(255, 247, 239, 0.5);
}
.rank-card.on .rank-num.r1 { color: var(--lxm-c-gold-bright, #FFE08A); }
.rank-card.on .rank-num.r2 { color: var(--lxm-c-gray-200, #F8EEE7); }
.rank-card.on .rank-num.r3 { color: var(--lxm-c-orange-bright, #FFC99A); }
.rank-more {
  justify-content: center;
  width: 116rpx;
  background: transparent;
  border: 1rpx dashed rgba(238, 44, 44, 0.45);
  box-shadow: none;
}
.rank-more-text {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--lxm-c-red, #EE2C2C);
}


