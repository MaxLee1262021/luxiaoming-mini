<view class="container">
  <lxm-privacy-modal />
  <lxm-toast id="lxmToast" />
  <view wx:if="{{loading}}" class="lxm-skeleton-wrap">
    <view class="lxm-skeleton lxm-skeleton-hero"></view>
    <view class="lxm-skeleton lxm-skeleton-block"></view>
    <view class="lxm-skeleton lxm-skeleton-block lxm-skeleton-block--short"></view>
  </view>
  <block wx:else>
  <view class="home-top {{headerCompact ? 'compact' : ''}}" style="--nav-top: {{navTopPx}}px; --capsule-safe-right: {{capsuleSafeRightPx}}px;">
    <view class="brand-header">
      <view class="brand-left">
        <view class="brand-logo">麓</view>
        <view class="brand-copy">
          <text class="brand-name">麓小鸣旅拍</text>
        </view>
      </view>
    </view>

    <view class="search-entry {{searchFocused ? 'focused' : ''}}">
      <view class="mini-logo">麓</view>
      <lxm-icon class="search-icon" type="search" size="20" color="red"></lxm-icon>
      <view class="search-keyword-wrap">
        <input
          class="search-input"
          value="{{searchKeyword}}"
          placeholder="搜索{{activeSearchKeyword}}"
          confirm-type="search"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
          bindfocus="onSearchFocus"
          bindblur="onSearchBlur"
        />
      </view>
      <view class="search-clear" wx:if="{{searchKeyword.length > 0}}" bindtap="clearSearchKeyword">
        <lxm-icon type="close" size="18" color="#FFFFFF"></lxm-icon>
      </view>
      <text class="search-action {{searchKeyword.length > 0 ? 'has-keyword' : ''}}" bindtap="onSearchConfirm">探索</text>
    </view>

    <lxm-search-panel
      wx:if="{{searchFocused}}"
      keyword="{{searchKeyword}}"
      hasInput="{{searchHasInput}}"
      suggestions="{{searchSuggestions}}"
      hotKeywords="{{hotSearchKeywords}}"
      top="{{searchDropdownTop}}"
      bind:itemtap="onSearchItemTap"
      bind:hottap="onHotSearchTap"
      bind:close="closeSearchDropdown"
      bind:booking="onSearchBooking"
    />
  </view>

  <view class="banner-wrap">
    <swiper class="banner-swiper" indicator-dots="{{false}}" autoplay="{{bannerAutoplay}}" interval="4000" duration="400" circular disable-touch="{{false}}" bindchange="onBannerChange" current="{{bannerIndex}}">
      <block wx:for="{{banners}}" wx:key="_id">
        <swiper-item>
          <view class="banner-click-area" bindtap="goBanner" data-index="{{index}}">
            <video wx:if="{{item.type === 'video'}}" class="banner-video" src="{{item.url}}" poster="{{item.cover || '/images/placeholder.png'}}" object-fit="cover" muted loop autoplay="{{index === bannerIndex}}" controls="{{false}}" show-center-play-btn="{{false}}" catchtap="goBanner" data-index="{{index}}" id="video-{{index}}"></video>
            <image wx:else class="banner-img" src="{{item.url || '/images/placeholder.png'}}" mode="aspectFill" lazy-load="{{index > 0}}" />
            <view class="banner-copy" catchtap="goBanner" data-index="{{index}}">
              <text class="banner-kicker">麓小鸣城市旅拍</text>
              <text class="banner-title">把长沙拍成你的旅行封面</text>
            </view>
          </view>
        </swiper-item>
      </block>
    </swiper>
    <view class="banner-dots">
      <view wx:for="{{banners}}" wx:key="_id" class="banner-dot {{index === bannerIndex ? 'active' : ''}}"></view>
    </view>
  </view>

  <view class="feature-zone lxm-panel" wx:if="{{moduleConfig.features.visible !== false}}">
    <view class="section-header">
      <view>
        <text class="section-title">特色专区</text>
      </view>
    </view>

    <!-- 地图探点横幅：去地图挑打卡点（指向探索地图页） -->
    <view class="map-banner" bindtap="goExplore" hover-class="map-banner--hover">
      <view class="map-banner-text">
        <text class="map-banner-title">在地图上挑打卡点</text>
        <text class="map-banner-sub">记录城市与你的故事</text>
        <view class="map-banner-go">去地图探点 ›</view>
      </view>
      <view class="map-banner-map">
        <view class="road h" style="top:34%"></view>
        <view class="road h" style="top:68%"></view>
        <view class="road v" style="left:28%"></view>
        <view class="road v" style="left:70%"></view>
        <view class="pin" style="left:22%;top:28%"></view>
        <view class="pin" style="left:50%;top:58%"></view>
        <view class="pin hollow" style="left:68%;top:36%"></view>
        <view class="pin" style="left:82%;top:70%"></view>
      </view>
    </view>

    <view class="feature-row">
      <view class="feature-card inspiration-feature" bindtap="goGuideList">
        <text class="feature-kicker">灵感</text>
        <text class="feature-name">旅拍灵感</text>
        <text class="feature-desc">旅拍灵感 · 机位与路线</text>
        <view class="feature-link">去看看<lxm-icon type="arrow-right" size="20" color="white"></lxm-icon></view>
      </view>
      <view class="feature-card goods-feature" bindtap="goPeripheralList">
        <text class="feature-kicker">好物</text>
        <text class="feature-name">影像周边</text>
        <view class="feature-desc">相册 · 相框 · 冲印 · DIY纪念</view>
        <view class="feature-link">点击查看<lxm-icon type="arrow-right" size="20" color="red"></lxm-icon></view>
      </view>
    </view>
  </view>

  <!-- 首页打卡点热榜：横滑追加点位，点击切换下方关联商品 -->
  <view class="spot-tabs" wx:if="{{spotTabs.length}}">
    <view class="spot-tabs-head">
      <view class="spot-tabs-copy">
        <text class="spot-tabs-title">打卡点热榜</text>
        <text class="spot-tabs-tip">按热度排名</text>
      </view>
    </view>
    <scroll-view class="spot-tabs-scroll" scroll-x show-scrollbar="{{false}}" lower-threshold="40" bindscrolltolower="onSpotReachEnd">
      <view
        wx:for="{{spotTabs}}"
        wx:key="_id"
        class="rank-card {{activeSpotId === item._id ? 'on' : ''}}"
        data-id="{{item._id}}"
        bindtap="onSpotTabTap"
        role="button"
        aria-label="查看{{item.name}}的商品"
      >
        <text class="rank-num {{item.rank <= 3 ? 'r' + item.rank : ''}}">{{item.rank}}</text>
        <image wx:if="{{item.cover}}" class="rank-cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
        <view wx:else class="rank-cover rank-cover--ph"></view>
        <text class="rank-name">{{item.name}}</text>
      </view>
      <view wx:if="{{spotLoadError}}" class="spot-tabs-status" bindtap="onSpotReachEnd" role="button" aria-label="重新加载打卡点">{{spotLoadError}}</view>
      <view wx:elif="{{spotLoadingMore || !spotHasMore}}" class="spot-tabs-status">{{spotLoadingMore ? '加载中…' : '已全部加载'}}</view>
    </scroll-view>
  </view>

  <view class="home-spot-products" wx:if="{{activeSpotId}}">
    <view wx:if="{{spotProductLoading}}" class="home-product-state">
      <text>正在加载{{activeSpotName}}的商品…</text>
    </view>
    <view wx:elif="{{spotProductError}}" class="home-product-state">
      <text>{{spotProductError}}</text>
      <button class="home-product-retry" bindtap="retrySpotProducts">重新加载</button>
    </view>
    <block wx:else>
      <view class="home-product-section" wx:if="{{moduleConfig.bookingAlbums.visible !== false && filteredAlbums.length}}">
        <view class="home-product-heading">
          <text class="home-product-title">{{moduleConfig.bookingAlbums.title || '照片留影'}}</text>
          <text class="home-product-spot">{{activeSpotName}}</text>
        </view>
        <scroll-view class="home-product-scroll home-album-scroll" scroll-x show-scrollbar="{{false}}">
          <view class="home-product-track">
            <lxm-album-card wx:for="{{filteredAlbums}}" wx:key="_id" item="{{item}}" mode="compact" bind:tap="onAlbumTap" />
          </view>
        </scroll-view>
      </view>

      <view class="home-product-section" wx:if="{{moduleConfig.videoProducts.visible !== false && filteredVideos.length}}">
        <view class="home-product-heading">
          <text class="home-product-title">{{moduleConfig.videoProducts.title || '视频摄像'}}</text>
          <text class="home-product-spot">{{activeSpotName}}</text>
        </view>
        <scroll-view class="home-product-scroll" scroll-x show-scrollbar="{{false}}">
          <view class="home-product-track">
            <lxm-video-card wx:for="{{filteredVideos}}" wx:key="_id" item="{{item}}" mode="product" variant="single" bind:tap="onVideoTap" />
          </view>
        </scroll-view>
      </view>

      <view class="home-product-section" wx:if="{{moduleConfig.hotPackages.visible !== false && filteredPackages.length}}">
        <view class="home-product-heading">
          <text class="home-product-title">{{moduleConfig.hotPackages.title || '旅拍套餐'}}</text>
          <text class="home-product-spot">{{activeSpotName}}</text>
        </view>
        <scroll-view class="home-product-scroll" scroll-x show-scrollbar="{{false}}">
          <view class="home-product-track">
            <lxm-package-card wx:for="{{filteredPackages}}" wx:key="_id" variant="home" item="{{item}}" bind:tap="onPackageTap" />
          </view>
        </scroll-view>
      </view>

      <lxm-custom-booking-card
        wx:if="{{!filteredAlbums.length && !filteredVideos.length && !filteredPackages.length && filteredPeripherals.length}}"
        title="专属定制"
        spotId="{{activeSpotId}}"
        spotName="{{activeSpotName}}"
        bind:booking="goCustomBooking"
      />

      <view class="home-product-section" wx:if="{{moduleConfig.peripherals.visible !== false && filteredPeripherals.length}}">
        <view class="home-product-heading">
          <text class="home-product-title">{{moduleConfig.peripherals.title || '影像周边'}}</text>
          <text class="home-product-spot">{{activeSpotName}}</text>
        </view>
        <scroll-view class="home-product-scroll" scroll-x show-scrollbar="{{false}}">
          <view class="home-product-track home-peripheral-track">
            <view wx:for="{{filteredPeripherals}}" wx:key="_id" class="peripheral-card" bindtap="onPeripheralTap" data-id="{{item._id}}" role="button" aria-label="查看{{item.name}}">
              <image class="peripheral-cover" src="{{item.cover || '/images/placeholder.png'}}" mode="aspectFill" lazy-load />
              <view class="peripheral-info">
                <text class="peripheral-name">{{item.name}}</text>
                <text class="peripheral-price" wx:if="{{item.hasPrice}}">¥{{item.priceText}}</text>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="home-product-state" wx:if="{{!filteredAlbums.length && !filteredVideos.length && !filteredPackages.length && !filteredPeripherals.length}}">
        <text>{{activeSpotName}}暂未上架商品</text>
        <text class="home-product-state-tip">可以看看其他打卡点</text>
      </view>
    </block>
  </view>

</block>

</view>
