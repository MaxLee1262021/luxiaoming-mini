<view class="physical-page">
  <text class="physical-title">{{selectMode ? '选择收货地址' : '我的收货地址'}}</text><text class="physical-sub" style="margin-bottom:26rpx">收件人电话可以与账户联系电话不同。</text>
  <view wx:if="{{error}}" class="physical-error">{{error}}<button class="physical-secondary" bindtap="load">重试</button></view>
  <view wx:if="{{loading}}" class="physical-empty physical-sub">正在读取地址…</view>
  <view wx:if="{{!loading && !items.length && !error}}" class="physical-card physical-empty"><text class="physical-title">还没有收货地址</text><text class="physical-sub">添加地址后可在结算时直接选择。</text></view>
  <view wx:for="{{items}}" wx:key="id" class="physical-card"><view data-index="{{index}}" bindtap="choose"><view class="physical-between"><text class="physical-title">{{item.recipient || item.name}} · {{item.phone}}</text><text wx:if="{{item.isDefault}}" class="physical-badge">默认</text></view><text class="physical-sub">{{item.addressText}}</text><text wx:if="{{selectMode}}" class="physical-link">选择此地址 ›</text></view><view class="physical-between" style="margin-top:18rpx"><text class="physical-link" wx:if="{{!item.isDefault}}" data-index="{{index}}" bindtap="setDefault">设为默认</text><view class="physical-row"><text class="physical-link" data-index="{{index}}" bindtap="edit">编辑</text><text class="physical-small" data-index="{{index}}" bindtap="remove">删除</text></view></view></view>
  <view class="physical-footer"><button class="physical-primary" bindtap="add">新增收货地址</button></view>
  <view wx:if="{{editing}}" class="physical-mask" bindtap="close"><view class="physical-sheet" catchtap="noop"><view class="physical-between"><text class="physical-title">{{form.id ? '编辑地址' : '新增地址'}}</text><text class="physical-close" bindtap="close">×</text></view><text class="physical-label">收货人</text><input class="physical-input" maxlength="40" value="{{form.recipient}}" placeholder="请输入收货人姓名" data-field="recipient" bindinput="input"/><text class="physical-label">收件人手机号</text><input class="physical-input" type="number" maxlength="11" value="{{form.phone}}" placeholder="11位手机号码" data-field="phone" bindinput="input"/><text class="physical-label">所在地区</text><picker mode="region" value="{{region}}" bindchange="region"><view class="physical-input">{{form.province ? form.province + ' ' + form.city + ' ' + form.district : '选择省、市、区县'}}</view></picker><text class="physical-label">详细地址</text><textarea class="physical-input" maxlength="200" value="{{form.detail}}" placeholder="街道、门牌号、楼栋房号，至少5个字" data-field="detail" bindinput="input"/><view class="physical-between" style="margin-top:20rpx"><text>设为默认地址</text><switch checked="{{form.isDefault}}" color="#ef653d" bindchange="defaultChange"/></view><button class="physical-primary" bindtap="save" disabled="{{busy}}" loading="{{busy}}">保存地址</button></view></view>
</view>
