.container {
  min-height: 100vh;
  padding: 0 24rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--lxm-c-bg);
  color: var(--lxm-c-ink);
}

.success-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 -24rpx 0;
  padding: 118rpx 32rpx 72rpx;
  border-radius: 0 0 30rpx 30rpx;
  background: linear-gradient(145deg, var(--lxm-c-ink) 0%, var(--lxm-c-red-press) 58%, var(--lxm-c-orange) 100%);
  box-shadow: 0 20rpx 54rpx rgba(64,39,26,0.16);
}

.success-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 24rpx;
  border-radius: 50%;
  background: rgba(255,247,239,0.92);
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-3xl);
  font-weight: 900;
}

.success-title {
  margin-bottom: 12rpx;
  color: var(--lxm-c-cream);
  font-size: var(--lxm-fz-xl);
  font-weight: 900;
}

.success-brand {
  display: inline-flex;
  align-items: center;
  margin-bottom: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--lxm-r-pill);
  background: rgba(42,33,27,0.32);
  color: var(--lxm-c-cream);
  font-size: var(--lxm-fz-base);
  font-weight: 900;
}

.success-subtitle {
  color: rgba(255,247,239,0.78);
  font-size: var(--lxm-fz-base);
  line-height: 1.6;
}

.info-card,
.tips-card {
  margin-bottom: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 30rpx;
  background: rgba(255,253,249,0.96);
  box-shadow: 0 16rpx 38rpx rgba(64,39,26,0.09);
}

.info-card {
  margin-top: -34rpx;
  position: relative;
  z-index: 2;
}

.card-title,
.tips-title {
  margin-bottom: 20rpx;
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-md);
  font-weight: 900;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 22rpx;
  padding: 13rpx 0;
}

.info-label {
  flex-shrink: 0;
  width: 126rpx;
  color: var(--lxm-c-gray-650);
  font-size: var(--lxm-fz-base);
}

.info-value {
  flex: 1;
  color: var(--lxm-c-gray-800);
  font-size: var(--lxm-fz-base);
  line-height: 1.45;
  text-align: right;
}

.info-value.price {
  color: var(--lxm-c-red-ink);
  font-weight: 900;
}

.info-value.message {
  word-break: break-all;
}

.sync-hint {
  margin: 8rpx 0 16rpx;
  color: var(--lxm-c-gray-650);
  font-size: var(--lxm-fz-xs);
  line-height: 1.5;
}

.order-no {
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-md);
  font-weight: 900;
}

.info-value-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
}

.copy-btn {
  position: relative;
  margin-left: 12rpx;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: var(--lxm-c-gold);
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-xs);
  font-weight: 900;
}

/* 无障碍：视觉不变，透明热区高度扩至 88rpx（WCAG 2.5.5） */
.copy-btn::after {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
  height: 88rpx;
  border: 0;
}

.divider {
  height: 1rpx;
  margin: 8rpx 0;
  background: var(--lxm-c-gray-350);
}

.mode-banner { margin: 0 0 20rpx; padding: 22rpx 24rpx; border-radius: 20rpx; }
.mode-banner.locked { background: var(--lxm-c-error-soft); border: 2rpx solid var(--lxm-c-red); }
.mode-banner.consult { background: var(--lxm-c-bg); border: 2rpx solid var(--lxm-c-gray-400); }
.mode-banner-title { font-size: var(--lxm-fz-md); font-weight: 900; color: var(--lxm-c-ink); }
.mode-banner.locked .mode-banner-title { color: var(--lxm-c-red-ink); }
.mode-banner-desc { margin-top: 8rpx; font-size: var(--lxm-fz-sm); color: var(--lxm-c-gray-750); line-height: 1.5; }

.btn-group {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.btn-group > button {
  flex: 1;
  width: 0;
  min-width: 0;
  margin: 0;
}

.btn-primary,
.btn-secondary,
.btn-tertiary,
.btn-lock {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0 0 16rpx;
  border-radius: 999rpx;
  font-size: var(--lxm-fz-md);
  font-weight: 900;
}

.btn-lock {
  background: linear-gradient(135deg, var(--lxm-c-red-press) 0%, var(--lxm-c-orange) 100%);
  color: var(--lxm-c-cream);
  box-shadow: 0 14rpx 30rpx rgba(238,44,44,0.28);
}

.btn-primary {
  background: linear-gradient(135deg, var(--lxm-c-ink), var(--lxm-c-gray-850));
  color: var(--lxm-c-cream);
}

.btn-secondary {
  background: linear-gradient(135deg, var(--lxm-c-red-press) 0%, var(--lxm-c-orange) 100%);
  color: var(--lxm-c-cream);
}

.btn-secondary.light,
.btn-tertiary {
  background: var(--lxm-c-surface);
  color: var(--lxm-c-red-ink);
  border: 2rpx solid var(--lxm-c-gray-450);
}

.btn-primary::after,
.btn-secondary::after,
.btn-tertiary::after {
  border: 0;
}

.tips-content {
  color: var(--lxm-c-gray-700);
  font-size: var(--lxm-fz-sm);
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 下单成功：入场动效（一次性，强化正反馈） */
.success-header {
  animation: lxm-rise 0.5s ease both;
}
.success-icon {
  animation: lxm-pop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
@keyframes lxm-rise {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes lxm-pop {
  0% { opacity: 0; transform: scale(0.6); }
  60% { opacity: 1; transform: scale(1.08); }
  100% { transform: scale(1); }
}
@media (prefers-reduced-motion: reduce) {
  .success-header, .success-icon { animation: none; }
}

.service-modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  padding-top: calc(48rpx + env(safe-area-inset-top));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.62);
  -webkit-backdrop-filter: blur(6rpx);
  backdrop-filter: blur(6rpx);
}

.service-modal-card {
  position: relative;
  width: 500rpx;
  max-width: 100%;
  overflow: hidden;
  border-radius: 36rpx;
  background: linear-gradient(155deg, #fff2ef 0%, #fff 72%);
  box-shadow: 0 28rpx 80rpx rgba(0, 0, 0, 0.2);
  animation: service-modal-appear 0.22s ease-out both;
}

.service-modal-scroll {
  display: block;
  height: 550rpx;
  max-height: calc(100vh - 96rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
}

.service-modal-content {
  padding: 44rpx 32rpx 4rpx;
  box-sizing: border-box;
  text-align: center;
}

.service-modal-close {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  min-width: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
}

.service-modal-close-mark {
  display: block;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #f0e9e6;
  color: #a39b97;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 35rpx;
  text-align: center;
}

.service-modal-close-pressed .service-modal-close-mark {
  background: #e5dcd7;
  color: var(--lxm-c-ink);
}

.service-modal-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto 24rpx;
  box-sizing: border-box;
  border: 6rpx solid #fff;
  border-radius: 50%;
  background: #ff522f;
  box-shadow: 0 10rpx 24rpx rgba(255, 82, 47, 0.18);
  font-size: 53rpx;
  line-height: 1;
}

.service-modal-title {
  color: #171514;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.service-modal-copy {
  margin-top: 10rpx;
  color: #78716e;
  font-size: 21rpx;
  line-height: 32rpx;
}

.service-modal-emphasis {
  color: #f4472b;
  font-weight: 700;
}

.service-modal-contact {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  width: 100%;
  height: 88rpx;
  min-height: 44px;
  margin: 40rpx 0 0;
  padding: 16rpx 12rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: linear-gradient(105deg, #ff6a31 0%, #fc472b 100%);
  color: #fff;
  box-shadow: 0 12rpx 26rpx rgba(252, 71, 43, 0.25);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 40rpx;
  white-space: nowrap;
}

.service-modal-contact-pressed {
  opacity: 0.88;
}

.service-modal-chat {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 26rpx;
  height: 20rpx;
  margin-bottom: 4rpx;
  box-sizing: border-box;
  border: 2rpx solid #322720;
  border-radius: 4rpx;
  background: #fff;
  color: #322720;
  font-size: 21rpx;
  line-height: 15rpx;
  letter-spacing: 1rpx;
}

.service-modal-chat::after {
  content: '';
  position: absolute;
  bottom: -7rpx;
  left: 5rpx;
  width: 7rpx;
  height: 7rpx;
  box-sizing: border-box;
  border-left: 2rpx solid #322720;
  border-bottom: 2rpx solid #322720;
  background: #fff;
  transform: skewY(-35deg);
}

.service-modal-later {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  min-height: 44px;
  margin: 4rpx 0 0;
  padding: 0;
  background: transparent;
  color: #9b9693;
  font-size: 21rpx;
  font-weight: 400;
  line-height: 32rpx;
  text-decoration: underline;
}

.service-modal-later-pressed {
  color: #6c6460;
}

.service-modal-close::after,
.service-modal-contact::after,
.service-modal-later::after {
  border: 0;
}

@media (max-width: 374px) {
  .service-modal-scroll {
    height: calc(374rpx + 88px);
  }
}

@keyframes service-modal-appear {
  from { opacity: 0; transform: translateY(12rpx) scale(0.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  .service-modal-card { animation: none; }
}
