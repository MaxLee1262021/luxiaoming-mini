<page-meta page-style="{{showCustomerServiceModal ? 'overflow: hidden;' : ''}}" />
<view class="container">
  <lxm-nav-bar showBack="{{true}}" />
  <lxm-privacy-modal />
  <lxm-toast id="lxmToast" />
  <view class="success-header">
    <view class="success-icon"><lxm-icon type="check" size="56" color="red"></lxm-icon></view>
    <view class="success-title">预约申请已提交</view>
    <view class="success-brand">记录城市与你的故事</view>
  </view>

  <view class="info-card">
    <view class="card-title">预约信息</view>
    <view class="info-row">
      <text class="info-label">当前状态</text>
      <text class="info-value price">{{statusText}}</text>
    </view>
    <view class="sync-hint" wx:if="{{loadError}}">{{loadError}}</view>
    <view class="info-row">
      <text class="info-label">预约编号</text>
      <view class="info-value-row">
        <text class="order-no">{{orderNo || '待生成'}}</text>
        <view class="copy-btn" bindtap="copyOrderNo" wx:if="{{orderNo}}">复制</view>
      </view>
    </view>
    <view class="divider"></view>
    <view class="info-row" wx:if="{{packageName}}">
      <text class="info-label">已选项目</text>
      <text class="info-value price">{{packageName}} ¥{{packagePrice}}</text>
    </view>
    <view class="info-row" wx:if="{{spotName}}">
      <text class="info-label">拍摄点位</text>
      <text class="info-value">{{spotName}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">预约时间</text>
      <text class="info-value">{{date || '未填写'}} {{timePeriod}}</text>
    </view>
    <view class="info-row" wx:if="{{contactName}}">
      <text class="info-label">联系人</text>
      <text class="info-value">{{contactName}}</text>
    </view>
    <view class="info-row" wx:if="{{contactPhone}}">
      <text class="info-label">手机号</text>
      <text class="info-value">{{contactPhone}}</text>
    </view>
    <view class="info-row" wx:if="{{contactWechat}}">
      <text class="info-label">微信号</text>
      <text class="info-value">{{contactWechat}}</text>
    </view>
    <view class="info-row" wx:if="{{message}}">
      <text class="info-label">预约备注</text>
      <text class="info-value message">{{message}}</text>
    </view>
    <view class="info-row" wx:if="{{workflowStage === 'awaiting_deposit' && depositDue > 0}}">
      <text class="info-label">待付定金</text>
      <text class="info-value price">¥{{depositDue}}</text>
    </view>
  </view>

  <view class="btn-group">
    <button class="btn-secondary" bindtap="contactService">联系客服</button>
    <button class="btn-primary" bindtap="goOrderDetail" wx:if="{{orderId || orderNo}}">查看订单</button>
  </view>

  <view class="tips-card">
    <view class="tips-title">温馨提示</view>
    <view class="tips-content">{{bookingSuccessTips}}</view>
  </view>

  <view wx:if="{{showCustomerServiceModal}}" class="service-modal-mask" catchtap="noop" catchtouchmove="noop">
    <view class="service-modal-card" aria-role="dialog" aria-label="预约成功，联系专属客服" catchtap="noop">
      <button class="service-modal-close" bindtap="closeCustomerServiceModal" aria-label="关闭联系客服提示" hover-class="service-modal-close-pressed">
        <text class="service-modal-close-mark" aria-hidden="true">×</text>
      </button>
      <scroll-view class="service-modal-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="service-modal-content">
          <view class="service-modal-avatar" aria-hidden="true"><text>👩🏻‍💼</text></view>
          <view class="service-modal-title">预约成功!</view>
          <view class="service-modal-copy">
            <view>为了给您安排最合适的摄影师</view>
            <view>请点击下方按钮联系专属客服</view>
            <view class="service-modal-emphasis">确认拍摄细节与具体时间</view>
          </view>
          <button class="service-modal-contact" bindtap="contactService" hover-class="service-modal-contact-pressed" aria-label="一键联系专属客服">
            <view class="service-modal-chat" aria-hidden="true"><text>···</text></view>
            <text>一键联系专属客服</text>
          </button>
          <button class="service-modal-later" bindtap="closeCustomerServiceModal" hover-class="service-modal-later-pressed">暂不联系，稍后再说</button>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
