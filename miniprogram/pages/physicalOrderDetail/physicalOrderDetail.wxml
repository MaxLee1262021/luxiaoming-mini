<view class="physical-page">
  <view wx:if="{{error}}" class="physical-error">{{error}}<button class="physical-secondary" bindtap="load">重新加载</button></view>
  <view wx:if="{{loading && !order}}" class="physical-empty physical-sub">正在读取订单…</view>
  <block wx:if="{{order}}">
    <view class="physical-card">
      <text wx:if="{{order.paymentMode === 'package'}}" class="physical-title">套餐内周边</text>
      <text class="physical-title">{{order.statusText}}</text>
      <text class="physical-sub">订单号 {{order.orderNo}}</text>
      <text class="physical-sub" wx:if="{{order.paymentMode === 'package' && order.parentOrderNo}}">关联套餐订单号 {{order.parentOrderNo}}</text>
      <text class="physical-sub" wx:if="{{order.paymentMode === 'package'}}">已包含在套餐金额中，无需另行付款。</text>
      <text class="physical-sub" wx:if="{{order.paymentMode !== 'package' && order.expiresAt && order.status === 'pending_payment'}}">请在 {{order.expiresAt}} 前付款，超时以系统核对结果为准。</text>
      <text class="physical-sub" wx:if="{{order.afterSaleStatus && order.afterSaleStatus !== 'none'}}">售后状态：{{order.afterSaleStatusText || order.afterSaleStatus}}</text>
      <text class="physical-sub" wx:if="{{paymentMessage}}">{{paymentMessage}}</text>
      <view class="physical-actions"><button wx:if="{{canPay}}" class="physical-primary" bindtap="pay" disabled="{{busy}}" loading="{{busy}}">继续付款</button><button wx:if="{{canPay}}" class="physical-secondary" bindtap="queryPayment" disabled="{{busy}}">查询支付结果</button><button wx:if="{{canCancel}}" class="physical-secondary" bindtap="cancel" disabled="{{busy}}">取消订单</button><button wx:if="{{canReceive}}" class="physical-primary" bindtap="receive" disabled="{{busy}}">确认收货</button><button class="physical-secondary" bindtap="contactService">联系客服</button></view>
    </view>
    <view class="physical-card"><text class="physical-small">收货信息</text><text class="physical-title" style="margin-top:14rpx">{{order.address.recipient || order.address.name}} · {{order.address.phone}}</text><text class="physical-sub">{{addressText}}</text><button wx:if="{{canAddress}}" class="physical-secondary physical-address-action" bindtap="chooseAddress" disabled="{{busy}}">{{order.status === "pending_payment" ? "修改收货地址" : "申请修改地址"}}</button><text class="physical-small" wx:if="{{order.addressChange.status}}">改址申请：{{order.addressChange.status === "pending" ? "待客服核实" : order.addressChange.status}}</text></view>
    <view wx:if="{{order.shipment}}" class="physical-card"><view class="physical-between"><text class="physical-title">物流信息</text><text class="physical-link" bindtap="refreshLogistics">刷新</text></view><text class="physical-sub">{{order.shipment.carrierName || order.shipment.companyName || order.shipment.carrier}} · {{order.shipment.trackingNo || order.shipment.trackingNumber || order.shipment.number || order.shipment.logisticsNo}}</text><text class="physical-link" bindtap="copyTracking">复制物流单号</text><text class="physical-sub">{{order.shipment.statusText || order.shipment.logisticsStatusText || '已出库，待快递揽收'}}</text><text class="physical-small" wx:if="{{order.shipment.updatedAt}}">最近同步 {{order.shipment.updatedAt}}</text><text class="physical-error" wx:if="{{logisticsError}}">{{logisticsError}}</text><view wx:for="{{tracking}}" wx:key="index" class="physical-timeline"><text class="physical-small">{{item.time || item.ftime || item.eventAt}}</text><text class="physical-sub">{{item.context || item.description || item.text}}</text></view><text wx:if="{{!tracking.length}}" class="physical-sub">物流信息暂未更新。暂无轨迹不代表快递尚未取走。</text></view>
    <view class="physical-card">
      <text class="physical-title">商品清单 · 共{{order.quantity}}件</text>
      <view wx:for="{{order.items}}" wx:key="id" class="physical-row physical-line"><image class="physical-cover" src="{{item.cover}}" mode="aspectFill"/><view class="physical-grow"><text class="physical-title">{{item.name}}</text><text class="physical-sub">{{item.spec}} × {{item.quantity}}</text><text class="physical-small">{{item.refundedQuantity ? '已退数量 ' + item.refundedQuantity : ''}}</text></view><text>{{order.paymentMode === 'package' ? '套餐包含' : '¥' + item.lineAmountText}}</text></view>
      <text class="physical-sub" wx:if="{{order.paymentMode === 'package'}}">商品金额已包含在套餐中，付款与退款进度请查看关联套餐订单。</text>
      <block wx:else>
        <view class="physical-between physical-line"><text>商品金额</text><text>¥{{order.goodsText}}</text></view><view class="physical-between physical-line"><text>合单运费</text><text>¥{{order.shippingText}}</text></view><view class="physical-between physical-line"><text>订单总额</text><text class="physical-price">¥{{order.totalText}}</text></view>
      </block>
      <view class="physical-actions physical-order-actions"><button class="physical-secondary" bindtap="contactService">联系客服</button><button class="physical-secondary" bindtap="buyAgain">再逛周边</button></view>
    </view>
    <view wx:if="{{afterSales.length}}" class="physical-card"><text class="physical-title">售后记录</text><view wx:for="{{afterSales}}" wx:key="id" class="physical-line"><text>{{item.statusText || item.status}} · ¥{{item.amountText}}</text><text class="physical-sub">{{item.reason}}</text><text class="physical-small">{{item.createdAt}}</text><view class="physical-row"><text class="physical-link" wx:for="{{item.attachments}}" wx:for-item="file" wx:for-index="fileIndex" wx:key="id" data-sale="{{index}}" data-index="{{fileIndex}}" bindtap="previewEvidence">查看凭证{{fileIndex + 1}}</text></view><text class="physical-sub" wx:if="{{item.returnAddressText}}">退货地址：{{item.returnAddressText}}</text><text class="physical-sub" wx:if="{{item.returnDeadline}}">请于 {{item.returnDeadline}} 前登记退货物流</text><text class="physical-sub" wx:if="{{item.returnShipment}}">退货物流：{{item.returnShipment.carrierName}} {{item.returnShipment.trackingNo}}</text><text class="physical-link" wx:if="{{item.returnShipment}}" data-index="{{index}}" bindtap="refreshReturn">查看 / 刷新退货物流</text><view wx:for="{{item.returnShipment.events}}" wx:for-item="event" wx:key="index" class="physical-timeline"><text class="physical-small">{{event.time}}</text><text class="physical-sub">{{event.context}}</text></view><button class="physical-secondary" wx:if="{{item.status === 'awaiting_return' && !item.returnShipment}}" data-index="{{index}}" bindtap="openReturn" disabled="{{busy}}">填写退货物流</button></view></view>
  </block>
  <view wx:if="{{returnSale}}" class="physical-mask" bindtap="closeReturn"><view class="physical-sheet" catchtap="noop"><view class="physical-between"><text class="physical-title">填写退货物流</text><text class="physical-close" bindtap="closeReturn">×</text></view><text class="physical-sub">{{returnSale.returnAddressText || '请先与客服核对退货地址，按审核意见寄回。'}}</text><text class="physical-label">快递公司（必选）</text><picker range="{{carriers}}" range-key="name" value="{{returnCarrierIndex}}" bindchange="returnCarrier"><view class="physical-input">{{returnCarrierIndex >= 0 ? carriers[returnCarrierIndex].name : '请选择实际寄回的快递公司'}}</view></picker><text class="physical-label">退货物流单号（必填）</text><input class="physical-input" value="{{returnTrackingNo}}" maxlength="64" placeholder="请输入实际退货单号" bindinput="returnTracking"/><text class="physical-sub">寄回并不代表退款成功，客服收到并核验后继续处理。</text><button class="physical-primary" bindtap="submitReturn" loading="{{busy}}" disabled="{{busy}}">提交退货单号</button></view></view>
</view>
