<view class="page">
  <lxm-nav-bar showBack="{{true}}" />
  <lxm-privacy-modal />
  <lxm-toast id="lxmToast" />
  <view wx:if="{{loading}}" class="lxm-skeleton-wrap">
    <view class="lxm-skeleton lxm-skeleton-hero"></view>
    <view class="lxm-skeleton lxm-skeleton-block"></view>
    <view class="lxm-skeleton lxm-skeleton-block lxm-skeleton-block--short"></view>
  </view>
  <view wx:elif="{{error}}" class="state">
    <view>{{error}}</view>
    <button class="state-btn" bindtap="retry">重新加载</button>
  </view>

  <block wx:else>
    <view class="hero">
      <image class="cover" src="{{item.cover}}" mode="aspectFill" bindtap="previewImage" data-url="{{item.cover}}" />
      <view class="hero-mask"></view>
      <view class="hero-copy">
        <text class="hero-kicker">麓小鸣周边</text>
        <text class="hero-title">{{item.name}}</text>
      </view>
    </view>
    <view wx:if="{{item.storeProductId && storeProductSupported}}" class="section store-product-section">
      <view class="section-title">微信小店商品</view>
      <view class="store-product-stage">
        <store-product appid="{{storeAppId}}" product-id="{{item.storeProductId}}" product-promotion-link="{{item.storeProductPromotionLink}}" bindentererror="onStoreProductError" />
      </view>
      <view class="store-product-tip">商品图片、价格和购买入口由微信小店提供，点击商品卡即可购买。</view>
    </view>
    <view wx:elif="{{item.storeProductId}}" class="section store-product-section store-product-unavailable">
      <view class="section-title">微信小店商品</view>
      <view class="store-product-tip">{{storeProductUnavailableText}}</view>
    </view>

    <view class="section">
      <view class="section-title">服务说明</view>
      <view class="info-item">如需定制，请咨询客服确认规格、数量和制作周期。</view>
      <view class="info-item">周边商品可与旅拍成片服务搭配咨询。</view>
    </view>

    <view class="lxm-foot-bar">
      <view class="lxm-foot-favorite">
        <lxm-favorite-button type="peripheral" item-id="{{item._id}}" item="{{item}}" />
      </view>
      <button class="lxm-foot-btn__main" bindtap="contactService">咨询客服</button>
    </view>
  </block>
</view>
