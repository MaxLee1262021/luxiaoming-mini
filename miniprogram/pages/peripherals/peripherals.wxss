page {
  background: var(--lxm-c-gray-200);
}

.peripherals-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  color: var(--lxm-c-ink);
  background: var(--lxm-c-gray-200);
}

/* ===== 工艺定制引言 ===== */
.custom-hero {
  padding: 36rpx 40rpx 20rpx;
}

.custom-kicker {
  display: block;
  font-size: 23rpx;
  font-weight: var(--lxm-fw-semibold);
  letter-spacing: 4rpx;
  color: var(--lxm-c-red-ink);
}

.custom-title {
  display: block;
  margin-top: 12rpx;
  font-size: 44rpx;
  font-weight: var(--lxm-fw-semibold);
  color: var(--lxm-c-ink);
  line-height: 1.2;
}

.custom-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 23rpx;
  color: var(--lxm-c-gray-650);
}

/* ===== 卡片堆叠展示柜（扑克发牌式层叠）===== */
.stack-stage {
  position: relative;
  flex: 1;
  min-height: 820rpx;
  overflow: visible;
}

.stack-hint {
  position: absolute;
  top: 14rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 23rpx;
  color: var(--lxm-c-muted);
  letter-spacing: 1rpx;
  z-index: 1;
}

.stack-center {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
}

.stack-card {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 460rpx;
  height: 580rpx;
  display: flex;
  flex-direction: column;
  border-radius: 30rpx;
  background: var(--lxm-c-surface);
  overflow: hidden;
  box-shadow: 0 18rpx 40rpx rgba(64, 39, 26, 0.18);
  transform-origin: center center;
  transition: transform 0.45s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.45s;
  will-change: transform;
}

.stack-card.front {
  box-shadow: 0 24rpx 54rpx rgba(238, 44, 44, 0.22);
}

.stack-cover {
  position: relative;
  width: 100%;
  height: 320rpx;
  background: linear-gradient(135deg, var(--lxm-c-orange), var(--lxm-c-red));
}

.stack-img {
  width: 100%;
  height: 100%;
  display: block;
}

.stack-badge {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  font-size: var(--lxm-fz-2xs);
  font-weight: var(--lxm-fw-semibold);
  color: var(--lxm-c-surface);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.stack-badge.hot {
  background: var(--lxm-c-red);
}

/* 爆款：金底墨字，区分于热卖(红) */
.stack-badge.sale {
  background: var(--lxm-c-gold);
  color: var(--lxm-c-ink);
}

.stack-badge.new {
  background: var(--lxm-c-orange);
}

.stack-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 20rpx 24rpx 24rpx;
}

.stack-name {
  font-size: 32rpx;
  font-weight: var(--lxm-fw-semibold);
  color: var(--lxm-c-ink);
  line-height: 1.3;
}

.stack-specs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.stack-spec {
  font-size: 23rpx;
  color: var(--lxm-c-gray-700);
  background: var(--lxm-c-gray-250);
  padding: 5rpx 14rpx;
  border-radius: 12rpx;
}

.stack-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.stack-price {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--lxm-c-red-ink);
}

.stack-btn {
  position: relative;
  font-size: var(--lxm-fz-md);
  font-weight: var(--lxm-fw-medium);
  color: var(--lxm-c-cream);
  background: var(--lxm-c-ink);
  padding: 12rpx 32rpx;
  border-radius: var(--lxm-r-xl);
}

/* 无障碍：视觉不变，透明热区高度扩至 88rpx（WCAG 2.5.5） */
.stack-btn::after {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
  height: 88rpx;
  border: 0;
}

.stack-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 8rpx 20rpx rgba(64, 39, 26, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 1;
  color: var(--lxm-c-orange);
  z-index: 120;
}

/* 无障碍：视觉不变，透明热区扩至 88rpx（WCAG 2.5.5） */
.stack-nav::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 88rpx;
  height: 88rpx;
  border: 0;
  border-radius: inherit;
}

.stack-nav.prev {
  left: 12rpx;
}

.stack-nav.next {
  right: 12rpx;
}

.stack-dots {
  position: absolute;
  bottom: 12rpx;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  z-index: 1;
}

.stack-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--lxm-c-gray-500);
  transition: all 0.3s;
}

.stack-dot.active {
  width: 30rpx;
  border-radius: 12rpx;
  background: var(--lxm-c-orange);
}
