@import "../../styles/physical.wxss";

page {
  background: var(--lxm-c-gray-200);
}

.peripherals-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  color: var(--lxm-c-ink);
  background: var(--lxm-c-gray-200);
  overflow-x: hidden;
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

.peripherals-content {
  position: relative;
  z-index: 0;
  flex: 1;
  min-width: 0;
}

.cart-entry {
  position: fixed;
  top: calc(var(--cart-nav-top, 26px) + 88rpx);
  right: 24rpx;
  width: 88rpx;
  height: 88rpx;
  min-width: 44px;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #765a45;
  box-shadow: 0 6rpx 18rpx rgba(64, 39, 26, 0.14);
  z-index: 60;
}

.cart-entry--pressed {
  opacity: 0.8;
  transform: scale(0.95);
}

.cart-entry-count {
  position: absolute;
  right: -8rpx;
  top: -4rpx;
  min-width: 34rpx;
  height: 34rpx;
  box-sizing: border-box;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fffaf6;
  border-radius: 20rpx;
  background: #ed4835;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

/* ===== 卡片堆叠展示柜（扑克发牌式层叠）===== */
.stack-stage {
  position: relative;
  flex: none;
  min-height: 820rpx;
  overflow: visible;
}

.stack-hint {
  position: absolute;
  top: 14rpx;
  left: 0;
  right: 0;
  padding: 0 120rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--lxm-c-muted);
  letter-spacing: 1rpx;
  z-index: 1;
}

.stack-center {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
}

.stack-card {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 460rpx;
  height: 580rpx;
  display: flex;
  flex-direction: column;
  border-radius: 30rpx;
  background: var(--lxm-c-surface);
  overflow: hidden;
  box-shadow: 0 18rpx 40rpx rgba(64, 39, 26, 0.18);
  transform-origin: center center;
  transition: transform 0.45s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.45s;
  will-change: transform;
}

.stack-card.front {
  box-shadow: 0 24rpx 54rpx rgba(238, 44, 44, 0.22);
}

.stack-cover {
  position: relative;
  width: 100%;
  height: 0;
  flex: 1;
  min-height: 0;
  background: linear-gradient(135deg, var(--lxm-c-orange), var(--lxm-c-red));
}

.stack-img {
  width: 100%;
  height: 100%;
  display: block;
}

.stack-badge {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  font-size: var(--lxm-fz-2xs);
  font-weight: var(--lxm-fw-semibold);
  color: var(--lxm-c-surface);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.stack-badge.hot {
  background: var(--lxm-c-red);
}

/* 爆款：金底墨字，区分于热卖(红) */
.stack-badge.sale {
  background: var(--lxm-c-gold);
  color: var(--lxm-c-ink);
}

.stack-badge.new {
  background: var(--lxm-c-orange);
}

.stack-info {
  flex: none;
  display: flex;
  flex-direction: column;
  padding: 20rpx 24rpx 24rpx;
  min-height: 0;
  overflow: hidden;
}

.stack-name {
  font-size: 32rpx;
  font-weight: var(--lxm-fw-semibold);
  color: var(--lxm-c-ink);
  line-height: 1.3;
  flex-shrink: 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.stack-specs {
  display: flex;
  flex-wrap: nowrap;
  flex-shrink: 0;
  gap: 12rpx;
  margin-top: 16rpx;
  overflow: hidden;
}

.stack-spec {
  font-size: 23rpx;
  color: var(--lxm-c-gray-700);
  background: var(--lxm-c-gray-250);
  padding: 5rpx 14rpx;
  border-radius: 12rpx;
  max-width: 100%;
  box-sizing: border-box;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stack-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 8rpx 20rpx rgba(64, 39, 26, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 1;
  color: var(--lxm-c-orange);
  z-index: 120;
}

/* 无障碍：视觉不变，透明热区扩至 88rpx（WCAG 2.5.5） */
.stack-nav::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 88rpx;
  height: 88rpx;
  border: 0;
  border-radius: inherit;
}

.stack-nav.prev {
  left: 12rpx;
}

.stack-nav.next {
  right: 12rpx;
}

.stack-dots {
  position: absolute;
  bottom: 12rpx;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  z-index: 1;
  flex-wrap: wrap;
  padding: 0 40rpx;
}

.stack-dot {
  position: relative;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--lxm-c-gray-500);
  transition: all 0.3s;
}

.stack-dot::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 24rpx;
  height: 88rpx;
}

.stack-dot.active {
  width: 30rpx;
  border-radius: 12rpx;
  background: var(--lxm-c-orange);
}

.peripheral-detail {
  margin: 12rpx 28rpx 0;
  padding: 32rpx;
  border-radius: 28rpx;
  background: var(--lxm-c-surface);
  box-sizing: border-box;
  min-width: 0;
  box-shadow: 0 8rpx 26rpx rgba(64, 39, 26, 0.04);
}

.detail-eyebrow {
  display: block;
  margin-bottom: 12rpx;
  color: var(--lxm-c-orange-ink);
  font-size: 24rpx;
}

.detail-name {
  display: block;
  color: var(--lxm-c-ink);
  font-size: 36rpx;
  font-weight: var(--lxm-fw-semibold);
  line-height: 1.5;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.detail-price {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.detail-price-label {
  color: var(--lxm-c-muted);
  font-size: 24rpx;
}

.detail-price-value {
  min-width: 0;
  color: var(--lxm-c-orange-ink);
  font-size: 36rpx;
  font-weight: var(--lxm-fw-semibold);
  overflow-wrap: anywhere;
  word-break: break-all;
}

.detail-chips {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 16rpx;
  min-width: 0;
}

.detail-chip {
  display: block;
  box-sizing: border-box;
  max-width: 100%;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: var(--lxm-c-gray-250);
  color: var(--lxm-c-gray-700);
  font-size: 24rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.detail-chip.category {
  color: var(--lxm-c-orange-ink);
  background: var(--lxm-c-gray-200);
}

.detail-section {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--lxm-c-gray-250);
  min-width: 0;
}

.detail-label {
  display: block;
  color: var(--lxm-c-ink);
  font-size: 27rpx;
  font-weight: var(--lxm-fw-semibold);
  line-height: 1.5;
}

.detail-description {
  display: block;
  margin-top: 12rpx;
  color: var(--lxm-c-gray-700);
  font-size: 27rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.detail-gallery {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.gallery-item {
  position: relative;
  height: 230rpx;
  min-width: 0;
  border-radius: 18rpx;
  overflow: hidden;
  background: var(--lxm-c-gray-250);
}

.gallery-image {
  display: block;
  width: 100%;
  height: 100%;
}

.gallery-video {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: var(--lxm-c-surface);
  background: rgba(64, 39, 26, 0.45);
  font-size: 24rpx;
}

.gallery-play {
  font-size: 42rpx;
}

.consult-bar {
  flex: none;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
}

.consult-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  margin: 0;
  padding: 20rpx 32rpx;
  border-radius: var(--lxm-r-xl);
  background: var(--lxm-gradient-primary);
  color: var(--lxm-c-surface);
  font-size: var(--lxm-fz-md);
  font-weight: var(--lxm-fw-semibold);
  line-height: 1.4;
}

.consult-button::after {
  border: 0;
}

.commerce-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 20rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fffaf6;
  border-top: 1rpx solid #eee3d8;
  z-index: 50;
}

.commerce-add,
.commerce-buy {
  flex: 1;
  min-width: 0;
  height: 104rpx;
  min-height: 104rpx;
  margin: 0;
  padding: 0 10rpx;
  font-size: 28rpx;
  border-radius: 52rpx;
  font-weight: 600;
  white-space: nowrap;
}

.commerce-add {
  background: #fff0dc;
  color: #b34f27;
}

.commerce-buy {
  background: linear-gradient(100deg, #ec3030, #ff7e43);
  color: white;
}

.commerce-add::after,
.commerce-buy::after {
  border: 0;
}

.physical-sheet .purchase-submit {
  width: 100%;
  height: 104rpx;
  min-height: 104rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  border-radius: 52rpx;
}

/* 选购弹窗：商品概览、独立滚动的规格和固定操作区。 */
.purchase-sheet {
  display: flex;
  flex-direction: column;
  height: 82vh;
  max-height: 88vh;
  padding: 0;
  overflow: hidden;
  border-radius: 26rpx 26rpx 0 0;
}

.purchase-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 24rpx 12rpx 32rpx;
  flex-shrink: 0;
}

.purchase-name {
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-all;
}

.purchase-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  font-size: 56rpx;
  line-height: 1;
  color: #292929;
}

.purchase-summary {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 0 32rpx 26rpx;
  flex-shrink: 0;
}

.purchase-cover {
  display: block;
  width: 164rpx;
  height: 164rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.purchase-summary-body {
  flex: 1;
  min-width: 0;
}

.purchase-price {
  display: block;
  color: #e87616;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.purchase-price-value {
  margin-left: 4rpx;
  font-size: 40rpx;
}

.purchase-selection {
  display: block;
  margin: 10rpx 0 16rpx;
  font-size: 24rpx;
  color: #777;
  line-height: 1.5;
  word-break: break-all;
}

.purchase-quantity-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
}

.purchase-stepper {
  gap: 0;
  border-radius: 8rpx;
  background: #f7f7f7;
  overflow: hidden;
}

.purchase-stepper button {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  background: #f7f7f7;
  color: #222;
  border-radius: 0;
}

.purchase-stepper button::after {
  border: 0;
}

.purchase-stepper button[disabled] {
  color: #c9c9c9;
}

.purchase-stepper input {
  width: 64rpx;
  height: 40rpx;
  border-left: 1rpx solid #ddd;
  border-right: 1rpx solid #ddd;
  color: #222;
}

.purchase-stock {
  color: #999;
  font-size: 25rpx;
}

.purchase-options-heading {
  padding: 4rpx 32rpx 26rpx;
  flex-shrink: 0;
  color: #222;
  font-size: 32rpx;
  font-weight: 700;
}

.purchase-options-hint {
  margin-left: 20rpx;
  color: #999;
  font-size: 24rpx;
  font-weight: 400;
}

.purchase-options-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.purchase-options {
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
  gap: 22rpx 16rpx;
  padding: 4rpx 32rpx 28rpx;
}

.purchase-option {
  max-width: 100%;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  border: 2rpx solid transparent;
  border-radius: 8rpx;
  background: #f7f7f7;
  color: #242424;
  font-size: 28rpx;
  line-height: 1.5;
  white-space: normal;
  word-break: break-all;
}

.purchase-option.active {
  border-color: #d97c32;
  background: #fff8f1;
  color: #d57529;
}

.purchase-option.unavailable {
  color: #aaa;
  background: #f7f7f7;
}

.purchase-unavailable {
  margin-left: 12rpx;
  font-size: 22rpx;
}

.purchase-footer {
  padding: 12rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
  background: #fff;
  border-top: 1rpx solid #f5f5f5;
}

.purchase-note,
.purchase-error {
  display: block;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.purchase-note {
  color: #999;
}

.purchase-error {
  color: #c54c28;
}

.physical-sheet .purchase-submit {
  height: 88rpx;
  min-height: 88rpx;
  margin: 0;
  line-height: 88rpx;
  border-radius: 12rpx;
  background: #ff9400;
  color: #fff;
  font-size: 32rpx;
}

.physical-sheet .purchase-submit[disabled] {
  background: #f2d2aa;
  color: #fff;
}
