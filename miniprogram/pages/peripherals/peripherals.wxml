<view class="peripherals-page">
  <lxm-nav-bar title="影像周边" showBack="{{true}}" theme="light" placeholder="{{true}}" />
  <lxm-privacy-modal />

  <view class="cart-entry" style="--cart-nav-top: {{cartNavTopPx}}px;" bindtap="goCart" hover-class="cart-entry--pressed" role="button" aria-label="周边购物车，{{cartQuantity}}件商品">
    <lxm-icon type="cart" size="56" color="gold" />
    <text class="cart-entry-count" wx:if="{{cartQuantity > 0}}">{{cartQuantity > 99 ? '99+' : cartQuantity}}</text>
  </view>

  <view class="peripherals-content">
  <view class="lxm-skeleton-wrap" wx:if="{{loading}}">
    <view class="lxm-skeleton-card" wx:for="{{[1,2,3,4]}}" wx:key="*this">
      <view class="lxm-skeleton lxm-skeleton-cover"></view>
      <view class="lxm-skeleton-body">
        <view class="lxm-skeleton lxm-skeleton-line sk-title"></view>
        <view class="lxm-skeleton lxm-skeleton-line sk-block"></view>
      </view>
    </view>
  </view>

  <block wx:else>
      <view wx:if="{{degraded}}" class="lxm-degrade-bar">
      <text class="lxm-degrade-bar__txt">商品加载失败，请稍后重试</text>
      <view class="lxm-degrade-bar__retry" bindtap="onRetryLoad" role="button" aria-label="重新加载周边">重新加载</view>
    </view>

    <!-- ===== 卡片堆叠展示柜（主推位，层层叠放）===== -->
    <view wx:if="{{allPeripherals.length}}" class="stack-stage" bindtouchstart="onStackTouchStart" bindtouchmove="onStackTouchMove" bindtouchend="onStackTouchEnd">
      <view class="stack-hint">左右滑动 · 点选查看周边</view>
      <view class="stack-center">
        <view
          wx:for="{{stackLayers}}"
          wx:key="_id"
          class="stack-card {{item.isFront ? 'front' : ''}}"
          style="{{item.stackStyle}}"
          catchtap="onStackTap"
          data-index="{{item._index}}"
        >
          <view class="stack-cover">
            <image class="stack-img" src="{{item.cover || '/images/placeholder.png'}}" mode="aspectFill" lazy-load />
            <view class="stack-badge hot" wx:if="{{item.isHot}}">热卖</view>
            <view class="stack-badge sale" wx:elif="{{item.isHotSale}}">爆款</view>
            <view class="stack-badge new" wx:elif="{{item.isNew}}">新品</view>
          </view>
          <view class="stack-info">
            <text class="stack-name">{{item.name}}</text>
            <view class="stack-specs" wx:if="{{item.specs.length}}">
              <text class="stack-spec" wx:for="{{item.stackSpecs}}" wx:for-item="s" wx:key="*this">{{s}}</text>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{allPeripherals.length > 1}}" class="stack-nav prev" bindtap="rotateRing" data-dir="-1" role="button" aria-label="上一个周边">‹</view>
      <view wx:if="{{allPeripherals.length > 1}}" class="stack-nav next" bindtap="rotateRing" data-dir="1" role="button" aria-label="下一个周边">›</view>
      <view class="stack-dots">
        <view
          wx:for="{{allPeripherals}}"
          wx:key="_id"
          class="stack-dot {{index === stackFront ? 'active' : ''}}"
          data-index="{{index}}"
          catchtap="onStackTap"
          role="button"
          aria-label="查看{{item.name}}"
        ></view>
      </view>
    </view>
    <lxm-empty-state wx:else type="package" title="周边整理中" desc="可咨询客服了解影像周边" />

    <view class="peripheral-detail" wx:if="{{featuredPeripheral}}" aria-live="polite">
      <text class="detail-eyebrow">当前周边</text>
      <text class="detail-name">{{featuredPeripheral.name}}</text>
      <view class="detail-price" wx:if="{{featuredPeripheral.hasPrice}}">
        <text class="detail-price-label">商品售价</text>
        <text class="detail-price-value">¥{{featuredPeripheral.priceText}}</text>
      </view>
      <view class="detail-chips" wx:if="{{featuredPeripheral.category || featuredPeripheral.tags.length}}">
        <text class="detail-chip category" wx:if="{{featuredPeripheral.category}}">{{featuredPeripheral.category}}</text>
        <text class="detail-chip" wx:for="{{featuredPeripheral.tags}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="detail-section" wx:if="{{featuredPeripheral.specs.length}}">
        <text class="detail-label">商品规格</text>
        <view class="detail-chips">
          <text class="detail-chip spec" wx:for="{{featuredPeripheral.specs}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
      <view class="detail-section" wx:if="{{featuredPeripheral.description}}">
        <text class="detail-label">商品说明</text>
        <text class="detail-description">{{featuredPeripheral.description}}</text>
      </view>
      <view class="detail-section" wx:if="{{featuredPeripheral.deliveryCycle}}">
        <text class="detail-label">交付周期</text>
        <text class="detail-description">{{featuredPeripheral.deliveryCycle}}</text>
      </view>
      <view class="detail-section" wx:if="{{featuredPeripheral.services.length}}">
        <text class="detail-label">服务说明</text>
        <view class="detail-chips">
          <text class="detail-chip spec" wx:for="{{featuredPeripheral.services}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
      <view class="detail-section" wx:if="{{featuredPeripheral.gallery.length}}">
        <text class="detail-label">商品图集</text>
        <view class="detail-gallery">
          <view class="gallery-item" wx:for="{{featuredPeripheral.gallery}}" wx:key="key" data-index="{{index}}" bindtap="previewPeripheralMedia" role="button" aria-label="预览{{item.type === 'video' ? '视频' : '图片'}}{{index + 1}}">
            <image wx:if="{{item.type === 'image' || item.poster}}" class="gallery-image" src="{{item.type === 'video' ? item.poster : item.url}}" mode="aspectFill" lazy-load />
            <view wx:if="{{item.type === 'video'}}" class="gallery-video"><text class="gallery-play">▶</text><text>视频</text></view>
          </view>
        </view>
      </view>
    </view>

    <view class="commerce-bar">
      <button class="commerce-add" bindtap="openPurchase" data-mode="cart" disabled="{{purchaseBusy}}">加入购物车</button>
      <button class="commerce-buy" bindtap="openPurchase" data-mode="direct" disabled="{{purchaseBusy}}">立即定制</button>
    </view>
  </block>
  </view>
  <view wx:if="{{purchaseVisible}}" class="physical-mask purchase-mask" bindtap="closePurchase" catchtouchmove="noop">
    <view class="physical-sheet purchase-sheet" catchtap="noop">
      <view class="purchase-heading">
        <text class="purchase-name">{{purchaseProduct.name}}</text>
        <view class="purchase-close" bindtap="closePurchase" role="button" aria-label="关闭选购弹窗">×</view>
      </view>
      <view class="purchase-summary">
        <image class="purchase-cover" src="{{purchaseProduct.cover}}" mode="aspectFill" />
        <view class="purchase-summary-body">
          <text class="purchase-price">¥<text class="purchase-price-value">{{selectedSku ? selectedSku.priceText : purchasePriceText}}</text></text>
          <text class="purchase-selection">{{selectedSku ? '已选：' + selectedSku.specLabel : (purchaseSelection.style !== null ? '已选样式：' + (purchaseSelection.style || '默认样式') + '，请选择规格' : '请选择样式和规格')}}</text>
          <view class="purchase-quantity-row">
            <view class="physical-stepper purchase-stepper">
              <button data-delta="-1" bindtap="purchaseQuantityChange" disabled="{{purchaseBusy || purchaseQuantity <= 1}}" aria-label="减少数量">−</button>
              <input type="number" value="{{purchaseQuantity}}" bindchange="purchaseQuantityChange" disabled="{{purchaseBusy}}" aria-label="购买数量" />
              <button data-delta="1" bindtap="purchaseQuantityChange" disabled="{{purchaseBusy || (selectedSku && (selectedSku.availableQuantity > 0 || selectedSku.available > 0) && purchaseQuantity >= (selectedSku.availableQuantity || selectedSku.available))}}" aria-label="增加数量">＋</button>
            </view>
            <text class="purchase-stock">{{selectedSku ? '有货' : '数量'}}</text>
          </view>
        </view>
      </view>
      <scroll-view class="purchase-options-scroll" scroll-y show-scrollbar="{{false}}">
        <view class="purchase-options-heading">样式</view>
        <view class="purchase-options">
          <view wx:for="{{purchaseSelection.styles}}" wx:key="value" class="purchase-option {{purchaseSelection.style === item.value ? 'active' : ''}} {{!item.available ? 'unavailable' : ''}}" data-value="{{item.value}}" bindtap="selectPurchaseStyle" role="button" aria-label="{{item.label}}{{item.available ? '' : '，暂不可售'}}" aria-disabled="{{!item.available || purchaseBusy}}" aria-pressed="{{purchaseSelection.style === item.value}}">
            <text>{{item.label}}</text><text wx:if="{{!item.available}}" class="purchase-unavailable">暂不可售</text>
          </view>
        </view>
        <view class="purchase-options-heading">规格<text wx:if="{{purchaseSelection.style === null}}" class="purchase-options-hint">请先选择样式</text></view>
        <view class="purchase-options">
          <view wx:for="{{purchaseSelection.specs}}" wx:key="value" class="purchase-option {{purchaseSelection.spec === item.value ? 'active' : ''}} {{!item.available ? 'unavailable' : ''}}" data-value="{{item.value}}" bindtap="selectPurchaseSpec" role="button" aria-label="{{item.label}}{{item.available ? '' : purchaseSelection.style === null ? '，请先选择样式' : '，暂不可售'}}" aria-disabled="{{!item.available || purchaseBusy}}" aria-pressed="{{purchaseSelection.spec === item.value}}">
            <text>{{item.label}}</text><text wx:if="{{!item.available && purchaseSelection.style !== null}}" class="purchase-unavailable">暂不可售</text>
          </view>
        </view>
      </scroll-view>
      <view class="purchase-footer">
        <text wx:if="{{purchaseError}}" class="purchase-error">{{purchaseError}}</text>
        <text class="purchase-note">{{purchaseMode === 'cart' ? '加入购物车后，结算时将重新确认价格与库存。' : '价格与库存以提交订单时为准。'}}</text>
        <button class="physical-primary purchase-submit" bindtap="confirmPurchase" disabled="{{purchaseBusy || !selectedSku}}" loading="{{purchaseBusy}}">{{purchaseMode === 'direct' ? '立即结算' : '加入购物车'}}</button>
      </view>
    </view>
  </view>
</view>
