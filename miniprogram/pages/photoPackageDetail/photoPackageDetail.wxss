page {
  background: var(--lxm-c-bg);
}

.page {
  min-height: 100vh;
  padding-bottom: 132rpx;
  background: var(--lxm-c-bg);
  color: var(--lxm-c-ink);
}

.state-box {
  margin: 160rpx 32rpx 0;
  padding: 48rpx 32rpx;
  border-radius: 26rpx;
  background: var(--lxm-c-gray-50);
  text-align: center;
}

.state-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0 auto 18rpx;
  border-radius: 50%;
  background: var(--lxm-c-red);
  color: var(--lxm-c-surface);
  font-size: var(--lxm-fz-xl);
  font-weight: 900;
}

.state-title {
  font-size: var(--lxm-fz-lg);
  font-weight: 900;
}

.state-desc {
  margin-top: 10rpx;
  color: var(--lxm-c-gray-700);
  font-size: var(--lxm-fz-sm);
}

.state-btn {
  position: relative;
  margin-top: 26rpx;
  border-radius: 999rpx;
  background: var(--lxm-c-ink);
  color: var(--lxm-c-cream);
}

/* ===== 组合价值信息卡 ===== */
.package-card {
  position: relative;
  z-index: 2;
  margin: 24rpx 22rpx 20rpx;
  padding: 30rpx;
  border-radius: 26rpx;
  background: var(--lxm-c-ink, #2A211B);
  color: var(--lxm-c-cream, #FFF7EF);
  overflow: hidden;
  box-shadow: 0 22rpx 46rpx rgba(64,39,26,0.22);
}

.package-card__decor {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.package-card__decor--tr {
  top: -46rpx;
  right: -46rpx;
  width: 180rpx;
  height: 180rpx;
  background: rgba(238,44,44,0.16);
}

.package-card__decor--bl {
  bottom: -60rpx;
  left: -60rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255,141,82,0.14);
}

.package-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.kicker-pill {
  padding: 7rpx 15rpx;
  border-radius: 999rpx;
  background: rgba(255,247,239,0.14);
  color: var(--lxm-c-cream, #FFF7EF);
  font-size: var(--lxm-fz-xs);
  font-weight: 900;
}

.sold-pill {
  padding: 7rpx 15rpx;
  border-radius: 999rpx;
  background: rgba(255,247,239,0.14);
  color: var(--lxm-c-cream, #FFF7EF);
  font-size: var(--lxm-fz-xs);
  font-weight: 900;
}

.sold-pill.is-hot-sale {
  background: var(--lxm-c-red, #EE2C2C);
}

.package-title {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  font-size: var(--lxm-fz-2xl);
  font-weight: 900;
  line-height: 1.25;
  color: var(--lxm-c-cream, #FFF7EF);
}

.package-description {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  color: var(--lxm-c-cream, #FFF7EF);
  font-size: var(--lxm-fz-sm);
  line-height: 1.65;
  opacity: .82;
}

.package-tags {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.package-tag {
  max-width: 100%;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255,247,239,.12);
  color: var(--lxm-c-cream, #FFF7EF);
  font-size: var(--lxm-fz-xs);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.combo-metrics {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
}

.combo-metric {
  padding: 17rpx 10rpx;
  border-radius: 20rpx;
  background: rgba(255,247,239,0.08);
  text-align: center;
}

.combo-metric__value {
  display: block;
  color: var(--lxm-c-gold, #FFD36A);
  font-size: var(--lxm-fz-xl);
  font-weight: 900;
  line-height: 1.1;
}

.combo-metric__label {
  display: block;
  margin-top: 8rpx;
  color: var(--lxm-c-cream, #FFF7EF);
  font-size: var(--lxm-fz-xs);
  font-weight: 900;
  opacity: .8;
}

.combo-price-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255,247,239,0.14);
}

.combo-price-left {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.combo-origin {
  color: var(--lxm-c-cream, #FFF7EF);
  font-size: var(--lxm-fz-sm);
  opacity: .65;
  text-decoration: line-through;
}

.combo-sale {
  color: var(--lxm-c-gold, #FFD36A);
  font-size: var(--lxm-fz-3xl);
  font-weight: 900;
}

.combo-tail {
  color: var(--lxm-c-cream, #FFF7EF);
  font-size: var(--lxm-fz-sm);
  opacity: .75;
}

.bottom-btn::after,
.state-btn::after {
  border: 0;
}

/* 无障碍：视觉不变，透明热区高度扩至 88rpx（WCAG 2.5.5） */
.state-btn::after {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
  height: 88rpx;
  border: 0;
}

.section {
  margin: 20rpx 22rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: var(--lxm-c-gray-50);
  box-shadow: var(--lxm-shadow-card);
}

.section-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.section-title {
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-lg);
  font-weight: 900;
}

.benefit-list {
  display: grid;
  gap: 14rpx;
}

.benefit-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--lxm-c-gray-150);
  font-size: var(--lxm-fz-sm);
  line-height: 1.45;
}

.benefit-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.benefit-label { color: var(--lxm-c-gray-700); flex-shrink: 0; }
.benefit-value { color: var(--lxm-c-ink); font-weight: 800; text-align: right; word-break: break-word; }


.section-badge {
  align-self: flex-start;
  padding: 7rpx 15rpx;
  border-radius: 999rpx;
  background: var(--lxm-c-red);
  color: var(--lxm-c-cream);
  font-size: var(--lxm-fz-xs);
  font-weight: 900;
}

.section-badge--auto {
  background: var(--lxm-c-gray-250);
  color: var(--lxm-c-gray-750);
}

.spot-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.spot-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  min-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--lxm-c-gray-150);
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-sm);
  font-weight: 900;
}

.spot-pill:active {
  background: var(--lxm-c-gray-200);
}

.spot-pill__arrow {
  margin-left: 2rpx;
  color: var(--lxm-c-gray-650);
  font-size: var(--lxm-fz-lg);
  line-height: 1;
}

.info-item {
  margin-bottom: 14rpx;
  color: var(--lxm-c-gray-800);
  font-size: var(--lxm-fz-base);
  line-height: 1.55;
}














/* ===== 套餐包含：子商品大卡 ===== */
.item-cards {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: var(--lxm-c-surface);
  box-shadow: 0 6rpx 18rpx rgba(64,39,26,0.06);
}

.item-card__dot {
  width: 10rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
}

.item-card__dot--album {
  background: var(--lxm-c-red, #EE2C2C);
}

.item-card__dot--video {
  background: var(--lxm-c-orange, #FF8D52);
}

.item-card__dot--peripheral {
  background: var(--lxm-c-gold, #FFD36A);
}

.item-card__main {
  flex: 1;
  min-width: 0;
}

.item-card__name {
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-base);
  font-weight: 900;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-card__specs {
  margin-top: 8rpx;
  color: var(--lxm-c-gray-700);
  font-size: var(--lxm-fz-sm);
  line-height: 1.4;
}

.item-card__meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.item-card__price {
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-base);
  font-weight: 900;
}

.item-card__arrow {
  color: var(--lxm-c-gray-650);
  font-size: var(--lxm-fz-2xl);
  line-height: 1;
  font-weight: 700;
}
