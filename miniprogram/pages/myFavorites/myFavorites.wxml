<view class="favorites-page">
  <lxm-nav-bar title="我的收藏" showBack="{{true}}" placeholder="{{true}}" theme="light" />
  <lxm-privacy-modal />
  <view class="page-heading">我的收藏</view>

  <view class="error-card" wx:if="{{error}}">
    <text>{{error}}</text>
    <button class="retry-button" bindtap="retry">重新加载</button>
  </view>

  <view class="loading-text" wx:if="{{loading && !items.length}}">正在加载收藏…</view>
  <lxm-empty-state
    wx:elif="{{!loading && !error && !items.length}}"
    type="collection"
    title="还没有收藏"
    desc="在详情页点击收藏，喜欢的拍摄项目和旅拍灵感会保存在这里。"
    button-text="去看看"
    bind:action="goExplore"
  />

  <view class="favorite-card" wx:for="{{items}}" wx:key="key" bindtap="openFavorite" data-key="{{item.key}}">
    <image class="favorite-cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
    <view class="favorite-copy">
      <text class="favorite-type">{{item.typeLabel}}</text>
      <text class="favorite-name">{{item.name}}</text>
      <text class="favorite-spot" wx:if="{{item.spotName}}">{{item.spotName}}</text>
      <view class="favorite-actions">
        <text class="favorite-price">{{item.priceText}}</text>
        <button class="remove-button" catchtap="removeFavorite" data-key="{{item.key}}" disabled="{{!!removingKey}}" loading="{{removingKey === item.key}}">取消收藏</button>
      </view>
    </view>
  </view>
  <view class="loading-text" wx:if="{{items.length}}">{{loading ? '正在加载…' : (hasMore ? '上拉加载更多' : '已经到底了')}}</view>
</view>
