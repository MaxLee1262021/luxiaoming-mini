.favorites-page {
  min-height: 100vh;
  padding: 0 24rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--lxm-c-bg);
}

.page-heading {
  padding: 18rpx 4rpx 26rpx;
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-xl);
  font-weight: var(--lxm-fw-bold);
}

.favorite-card {
  display: flex;
  gap: 22rpx;
  margin-bottom: 22rpx;
  padding: 22rpx;
  border-radius: var(--lxm-r-lg);
  background: var(--lxm-c-surface);
  box-shadow: var(--lxm-shadow-card);
}

.favorite-cover {
  flex-shrink: 0;
  width: 184rpx;
  height: 210rpx;
  border-radius: var(--lxm-r-md);
  background: var(--lxm-c-fill);
}

.favorite-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.favorite-type {
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-xs);
}

.favorite-name {
  margin-top: 10rpx;
  font-size: var(--lxm-fz-md);
  font-weight: var(--lxm-fw-bold);
  color: var(--lxm-c-ink);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.favorite-spot {
  margin-top: 8rpx;
  font-size: var(--lxm-fz-xs);
  color: var(--lxm-c-muted);
}

.favorite-actions {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: auto;
  padding-top: 14rpx;
}

.favorite-price {
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-md);
  font-weight: var(--lxm-fw-bold);
}

.remove-button, .retry-button {
  flex-shrink: 0;
  min-height: 72rpx;
  padding: 0 18rpx;
  margin: 0;
  border-radius: var(--lxm-r-pill);
  background: var(--lxm-c-gray-150);
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-xs);
}

.remove-button::after, .retry-button::after { border: 0; }
.loading-text { padding: 32rpx 0; text-align: center; color: var(--lxm-c-muted); font-size: var(--lxm-fz-sm); }
.error-card { padding: 24rpx; background: var(--lxm-c-surface); border-radius: var(--lxm-r-md); color: var(--lxm-c-muted); }
.retry-button { margin-top: 20rpx; }
