/* 「我的」页 · 视觉统一版（UI Designer）
   仅替换颜色/字号为设计令牌，布局结构不变，零风险。 */

.my-page {
  min-height: 100vh;
  /* Reserve the fixed custom tab bar so the final service rows can scroll fully into view. */
  padding: 0 24rpx calc(152rpx + env(safe-area-inset-bottom));
  background: var(--lxm-c-bg);
  color: var(--lxm-c-ink);
}

.user-section {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  /* The profile row starts below the native capsule, so it can use the full width. */
  padding-top: calc(var(--nav-top, 26px) + 80rpx);
  padding-bottom: 30rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  margin: 0 -24rpx 22rpx;
  border-radius: 0 0 30rpx 30rpx;
  background:
    linear-gradient(135deg, rgba(249,242,106,0.18) 0%, rgba(249,242,106,0) 42%),
    var(--lxm-gradient-dark);
  box-shadow: 0 16rpx 34rpx rgba(64,39,26,0.14);
}

.user-avatar-wrap {
  flex: 0 0 120rpx;
  width: 120rpx;
  /* Keep a stable visual gap between the fixed avatar and profile copy. */
  margin-right: 104rpx;
}
.avatar-select {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  min-width: 120rpx;
  box-sizing: border-box;
}

.user-avatar {
  display: block;
  width: 112rpx;
  height: 112rpx;
  box-sizing: border-box;
  border-radius: 50%;
  background: var(--lxm-c-gray-400);
  border: 4rpx solid rgba(255,255,255,0.32);
}

.user-detail {
  flex: 1 1 0;
  min-width: 0;
  margin-right: 0;
  text-align: left;
}

.user-name-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex-wrap: wrap;
  min-width: 0;
  gap: 8rpx 12rpx;
  margin-bottom: 8rpx;
}

.user-nickname {
  flex: 0 1 auto;
  min-width: 0;
  max-width: calc(100% - 96rpx);
  color: var(--lxm-c-cream);
  font-size: var(--lxm-fz-lg);
  font-weight: var(--lxm-fw-bold);
  line-height: 1.35;
  overflow: hidden;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-role-tag {
  flex: 0 0 auto;
  padding: 5rpx 13rpx;
  border-radius: var(--lxm-r-pill);
  font-size: var(--lxm-fz-xs);
  font-weight: var(--lxm-fw-bold);
  line-height: 1.2;
  white-space: nowrap;
}

/* 角色标签：统一为品牌暖色系，去除原本的蓝/紫等非品牌色 */
.role-visitor { background: var(--lxm-c-gold-soft); color: var(--lxm-c-red-ink); }
.role-member { background: var(--lxm-c-ink); color: var(--lxm-c-gold); }
.role-admin { background: var(--lxm-c-ink); color: var(--lxm-c-gold); }
.role-service { background: var(--lxm-c-gold-soft-2); color: var(--lxm-c-red-ink); }
.role-photographer { background: var(--lxm-c-error-bg); color: var(--lxm-c-red-ink); }
.role-shop { background: var(--lxm-c-gold); color: var(--lxm-c-red-ink); }

.user-signature {
  display: block;
  color: rgba(255,247,239,0.72);
  font-size: var(--lxm-fz-sm);
  line-height: 1.45;
  overflow: hidden;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.auth-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: var(--lxm-r-md);
  background: var(--lxm-c-surface);
  box-shadow: var(--lxm-shadow-card);
}

.auth-title,
.auth-desc {
  display: block;
}

.auth-title {
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-md);
  font-weight: var(--lxm-fw-bold);
}

.auth-desc {
  margin-top: 8rpx;
  color: var(--lxm-c-muted);
  font-size: var(--lxm-fz-sm);
  line-height: 1.45;
}

.auth-btn {
  flex-shrink: 0;
  width: 168rpx;
  height: 68rpx;
  line-height: 68rpx;
  margin: 0;
  border-radius: var(--lxm-r-pill);
  background: var(--lxm-c-ink);
  color: var(--lxm-c-gold);
  font-size: var(--lxm-fz-sm);
  font-weight: var(--lxm-fw-bold);
}

.auth-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.auth-btn.dev {
  background: var(--lxm-c-gold-soft);
  color: var(--lxm-c-red-ink);
}

.auth-btn::after { border: 0; }

/* 底部法律链接（隐私政策） */
.legal-row {
  text-align: center;
  padding: 8rpx 10rpx 2rpx;
}

.legal-link {
  position: relative;
  font-size: var(--lxm-fz-xs);
  color: var(--lxm-c-muted-2);
  text-decoration: underline;
  text-underline-offset: 3rpx;
}

/* 无障碍：隐私政策链接太小，扩出 88rpx 透明热区（WCAG 2.5.5） */
.legal-link::after {
  content: '';
  position: absolute;
  left: -12rpx;
  right: -12rpx;
  top: 50%;
  transform: translateY(-50%);
  height: 88rpx;
}

.card,
.service-card {
  margin-bottom: 24rpx;
  border-radius: var(--lxm-r-md);
  background: var(--lxm-c-surface);
  box-shadow: var(--lxm-shadow-card);
}

.card-title {
  display: block;
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-lg);
  font-weight: var(--lxm-fw-bold);
}

.card { padding: 24rpx; }

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-more {
  color: var(--lxm-c-muted);
  font-size: var(--lxm-fz-sm);
  font-weight: var(--lxm-fw-bold);
}

.order-status-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0;
}

.order-status-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  min-height: 132rpx;
  padding: 6rpx 0;
  box-sizing: border-box;
}

/* 无障碍：视觉不变，透明热区高度扩至 88rpx（WCAG 2.5.5） */
.order-status-item::after {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
  height: 88rpx;
  border: 0;
}

.status-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-name {
  display: block;
  max-width: 100%;
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-2xs);
  font-weight: var(--lxm-fw-semibold);
  line-height: 1.3;
  text-align: center;
  white-space: normal;
}

.status-count {
  display: block;
  margin-top: 8rpx;
  color: var(--lxm-c-muted-2);
  font-size: var(--lxm-fz-2xs);
  line-height: 1.2;
}

.logout-area {
  display: flex;
  width: 100%;
  margin: 0 0 24rpx;
}

.logout-btn {
  flex: 1 1 0;
  min-width: 0;
  width: 100%;
  height: 92rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--lxm-r-md);
  background: var(--lxm-c-surface);
  color: var(--lxm-c-red);
  font-size: var(--lxm-fz-md);
  font-weight: var(--lxm-fw-bold);
  line-height: 1;
  text-align: center;
  box-shadow: var(--lxm-shadow-card);
}

.logout-btn::after {
  border: 0;
}

.section-title-text {
  padding: 4rpx 0 16rpx 8rpx;
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-lg);
  font-weight: var(--lxm-fw-bold);
}

.service-card { overflow: hidden; }

.service-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 104rpx;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid var(--lxm-c-line);
  box-sizing: border-box;
}

.service-item:last-child { border-bottom: 0; }

.contact-service-item {
  position: relative;
}

.contact-hit {
  display: block;
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  opacity: 0;
}

/* 无障碍：视觉不变，透明热区高度扩至 88rpx（WCAG 2.5.5） */
.contact-hit::after {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
  height: 88rpx;
  border: 0;
}

.service-main {
  flex: 1;
  min-width: 0;
  padding-right: 18rpx;
}

.service-text {
  display: block;
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-md);
  font-weight: var(--lxm-fw-bold);
}

.service-desc {
  display: block;
  margin-top: 7rpx;
  color: var(--lxm-c-muted-2);
  font-size: var(--lxm-fz-xs);
  line-height: 1.35;
}

.service-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
  width: 132rpx;
}

.online-tag {
  margin-right: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--lxm-r-pill);
  background: var(--lxm-c-gold);
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-xs);
  font-weight: var(--lxm-fw-bold);
}

.service-arrow {
  flex-shrink: 0;
  color: var(--lxm-c-muted-2);
  font-size: var(--lxm-fz-lg);
  font-weight: var(--lxm-fw-bold);
}

.brand-footer {
  padding: 26rpx 10rpx 0;
  text-align: center;
}

.brand-footer-title {
  display: block;
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-sm);
  font-weight: var(--lxm-fw-bold);
}

.brand-footer-desc {
  display: block;
  margin-top: 8rpx;
  color: var(--lxm-c-muted-2);
  font-size: var(--lxm-fz-xs);
}
