<view class="my-page" style="--nav-top: {{navTopPx}}px; --capsule-safe-right: {{capsuleSafeRightPx}}px;">
  <lxm-privacy-modal />
  <lxm-toast id="lxmToast" />
  <view class="user-section">
    <view class="user-avatar-wrap">
      <view class="avatar-select">
        <image class="user-avatar" src="/images/default-avatar.jpg" mode="aspectFill" />
      </view>
    </view>
    <view class="user-detail">
      <view class="user-name-row">
        <text class="user-nickname">鹿小鸣旅拍</text>
        <view class="user-role-tag role-{{roleType}}">{{roleLabel}}</view>
      </view>
      <text class="user-signature">{{authReady ? (phone ? ('联系电话 ' + phone) : '已登录，可查看订单') : '授权后查看订单、预约和客服服务'}}</text>
    </view>
  </view>

  <view class="auth-panel" wx:if="{{!authReady}}">
    <view>
      <text class="auth-title">微信手机号一键授权</text>
    </view>
    <view class="auth-actions">
      <button class="auth-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{authLoading}}">去授权</button>
    </view>
  </view>

  <view class="card order-card">
    <view class="card-header">
      <text class="card-title">订单状态</text>
    </view>
    <view class="order-status-row">
      <view class="order-status-item" bindtap="goToOrders" data-status="pending_payment">
        <view class="status-icon-wrap"><lxm-icon type="order" size="42" color="ink"></lxm-icon></view>
        <text class="status-name">待支付</text>
      </view>
      <view class="order-status-item" bindtap="goToOrders" data-status="awaiting_photographer">
        <view class="status-icon-wrap"><lxm-icon type="service" size="42" color="ink"></lxm-icon></view>
        <text class="status-name">待安排</text>
      </view>
      <view class="order-status-item" bindtap="goToOrders" data-status="shot">
        <view class="status-icon-wrap"><lxm-icon type="photo" size="42" color="ink"></lxm-icon></view>
        <text class="status-name">已拍摄</text>
      </view>
      <view class="order-status-item" bindtap="goToOrders" data-status="delivered">
        <view class="status-icon-wrap"><lxm-icon type="package" size="42" color="ink"></lxm-icon></view>
        <text class="status-name">已交付</text>
      </view>
      <view class="order-status-item" bindtap="goToOrders" data-status="">
        <view class="status-icon-wrap"><lxm-icon type="order" size="42" color="ink"></lxm-icon></view>
        <text class="status-name">全部订单</text>
      </view>
    </view>
  </view>

  <view class="section-title-text">常用服务</view>
  <view class="service-card">
    <view class="service-item" hover-class="lxm-card-lift" bindtap="goToMyBookings">
      <view class="service-main">
        <text class="service-text">我的预约</text>
      </view>
      <lxm-icon class="service-arrow" type="arrow-right" size="28" color="muted"></lxm-icon>
    </view>
    <view class="service-item" hover-class="lxm-card-lift" bindtap="goToPeripherals">
      <view class="service-main">
        <text class="service-text">影像周边</text>
      </view>
      <lxm-icon class="service-arrow" type="arrow-right" size="28" color="muted"></lxm-icon>
    </view>
  </view>

  <view class="section-title-text">服务帮助</view>
  <view class="service-card">
    <view class="service-item contact-service-item">
      <view class="service-main">
        <text class="service-text">联系客服</text>
      </view>
      <view class="service-right">
        <text class="online-tag">在线</text>
        <lxm-icon class="service-arrow" type="arrow-right" size="28" color="muted"></lxm-icon>
      </view>
      <button class="contact-hit" bindtap="openCustomerService"></button>
    </view>
    <view class="service-item" hover-class="lxm-card-lift" bindtap="goToNotice">
      <view class="service-main">
        <text class="service-text">预约须知</text>
      </view>
      <lxm-icon class="service-arrow" type="arrow-right" size="28" color="muted"></lxm-icon>
    </view>
  </view>

  <view class="logout-area" wx:if="{{authReady}}">
    <button class="logout-btn" bindtap="onLogout">退出登录</button>
  </view>

  <view class="legal-row">
    <text class="legal-link" bindtap="goToPrivacy">隐私政策</text>
  </view>

  <view class="brand-footer">
    <text class="brand-footer-title">鹿小鸣城市旅拍</text>
  </view>
</view>
