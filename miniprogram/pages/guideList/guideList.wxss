.guide-list-page {
  min-height: 100vh;
  background: var(--lxm-c-bg);
  padding: 20rpx 24rpx calc(40rpx + constant(safe-area-inset-bottom));
  padding: 20rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

/* 加载态 hero 骨架：高度与真实 hero 一致，避免加载完布局跳变 */
.gl-skeleton-hero {
  height: 380rpx;
  border-radius: var(--lxm-r-md);
  margin-bottom: 44rpx;
}

.gl-chips {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  padding: 18rpx 0 18rpx;
  /* 关键：给标签栏实心背景，盖住上方 hero 卡片的投影，避免阴影从胶囊间隙透出 */
  background: var(--lxm-c-bg);
  position: relative;
  z-index: 1;
}

.gl-chip {
  position: relative;
  flex: none;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: var(--lxm-c-surface);
  color: var(--lxm-c-gray-750);
  font-size: var(--lxm-fz-sm);
  font-weight: var(--lxm-fw-bold);
  border: 1rpx solid var(--lxm-c-gray-300);
  line-height: 1.2;
  white-space: nowrap;
}

/* 无障碍：视觉不变，透明热区高度扩至 88rpx（WCAG 2.5.5 最小触摸目标） */
.gl-chip::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  height: 88rpx;
  border: 0;
  border-radius: inherit;
}

.gl-chip.on {
  background: var(--lxm-gradient-primary);
  color: var(--lxm-c-cream);
  border-color: transparent;
}

.gl-waterfall {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.gl-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

/* 本期推荐 · 国风杂志流 hero */
.gl-feature {
  margin-bottom: 44rpx;
  border-radius: var(--lxm-r-md);
  background: var(--lxm-c-surface);
  overflow: hidden;
  /* 投影下沿约 38rpx，小于 44rpx 间距，配合标签栏实心背景彻底不压字 */
  box-shadow: 0 12rpx 26rpx rgba(64, 39, 26, 0.12);
}

.glf-cover {
  position: relative;
  width: 100%;
  height: 380rpx;
  overflow: hidden;
}

.glf-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 底部渐变蒙版：保证白字在深底上的 WCAG AA 对比度 */
.glf-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 210rpx;
  background: linear-gradient(to top, rgba(42, 33, 27, 0.84) 0%, rgba(42, 33, 27, 0.32) 55%, rgba(42, 33, 27, 0) 100%);
}

/* 鹿印章：右上角圆形，呼应品牌视觉 */
.glf-seal {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(238, 44, 44, 0.92);
  color: var(--lxm-c-cream);
  font-size: var(--lxm-fz-lg);
  font-weight: 900;
  line-height: 64rpx;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(238, 44, 44, 0.34);
  border: 2rpx solid rgba(255, 211, 106, 0.55);
}

.glf-cap {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 22rpx;
}

.glf-eyebrow {
  font-size: var(--lxm-fz-2xs);
  color: var(--lxm-c-gold);
  letter-spacing: 3rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.glf-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--lxm-c-cream);
  line-height: 1.28;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.glf-desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: rgba(255, 247, 239, 0.92);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.glf-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: var(--lxm-fz-xs);
  color: rgba(255, 247, 239, 0.86);
}

.glf-spot {
  font-weight: 700;
}
