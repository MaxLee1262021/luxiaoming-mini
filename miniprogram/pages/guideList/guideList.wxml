<view class="guide-list-page">
  <lxm-nav-bar showBack="{{true}}" title="{{title}}" theme="light" placeholder="{{true}}" />
  <lxm-privacy-modal />
  <lxm-toast id="lxmToast" />

  <view wx:if="{{loading}}" class="lxm-skeleton-wrap">
    <view class="lxm-skeleton gl-skeleton-hero"></view>
    <view class="lxm-skeleton-card" wx:for="{{[1,2,3,4]}}" wx:key="*this">
      <view class="lxm-skeleton lxm-skeleton-cover"></view>
      <view class="lxm-skeleton-body">
        <view class="lxm-skeleton lxm-skeleton-line sk-title"></view>
        <view class="lxm-skeleton lxm-skeleton-line sk-block"></view>
        <view class="lxm-skeleton lxm-skeleton-line sk-short"></view>
      </view>
    </view>
  </view>

  <block wx:elif="{{guides.length}}">
    <!-- 后台置顶文章轮播展示，下方列表按入口打卡点关联；分类筛选同步作用于两区。 -->
    <view wx:if="{{visibleFeaturedGuides.length}}" class="gl-feature">
      <swiper class="gl-feature-swiper" current="{{featuredIndex}}" autoplay="{{visibleFeaturedGuides.length > 1}}" circular="{{visibleFeaturedGuides.length > 1}}" interval="5000" duration="400" bindchange="onFeaturedChange">
        <swiper-item wx:for="{{visibleFeaturedGuides}}" wx:key="_id" wx:for-item="guide">
          <view class="glf-cover" bindtap="goGuideDetail" data-id="{{guide._id}}" role="button" aria-label="查看推荐文章：{{guide.title}}">
            <image class="glf-img" src="{{guide.image || guide.cover || '/images/placeholder.png'}}" mode="aspectFill" />
            <view class="glf-mask"></view>
            <view class="glf-seal" aria-hidden="true">麓</view>
            <view class="glf-cap">
              <view class="glf-eyebrow">本期推荐</view>
              <view class="glf-title">{{guide.title}}</view>
              <view wx:if="{{guide.description}}" class="glf-desc">{{guide.description}}</view>
              <view class="glf-meta">
                <text wx:if="{{guide.spotName}}" class="glf-spot">{{guide.spotName}}</text>
                <text class="glf-dot" wx:if="{{guide.spotName}}">·</text>
                <text>{{guide.readCount || 0}} 人已看</text>
              </view>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view wx:if="{{visibleFeaturedGuides.length > 1}}" class="gl-feature-pagination">{{featuredIndex + 1}} / {{visibleFeaturedGuides.length}}</view>
    </view>

    <scroll-view wx:if="{{chips.length > 1}}" class="gl-chips" scroll-x show-scrollbar="{{false}}">
      <view class="gl-chips-track">
        <view
          class="gl-chip {{activeChip === item.key ? 'on' : ''}}"
          wx:for="{{chips}}"
          wx:key="key"
          role="button"
          aria-label="筛选分类：{{item.label}}"
          data-cat="{{item.key}}"
          bindtap="onChipTap"
        >{{item.label}}</view>
      </view>
    </scroll-view>

    <view wx:if="{{feedGuides.length}}" class="gl-sort" aria-label="文章排序">
      <view
        wx:for="{{sortOptions}}"
        wx:key="key"
        class="gl-sort-option {{activeSort === item.key ? 'on' : ''}}"
        role="button"
        aria-label="{{item.key === 'default' ? '默认排序' : item.key === 'readCount' ? '按浏览人数从高到低排序' : '按评分从高到低排序'}}"
        data-sort="{{item.key}}"
        bindtap="onSortTap"
      >{{item.label}}</view>
    </view>

    <view wx:if="{{filteredGuides.length}}" class="gl-waterfall">
      <view class="gl-col">
        <lxm-guide-card
          wx:for="{{leftGuides}}"
          wx:key="_id"
          item="{{item}}"
          variant="waterfall"
          bind:tap="goGuideDetail"
        />
      </view>
      <view class="gl-col">
        <lxm-guide-card
          wx:for="{{rightGuides}}"
          wx:key="_id"
          item="{{item}}"
          variant="waterfall"
          bind:tap="goGuideDetail"
        />
      </view>
    </view>

    <lxm-empty-state
      wx:elif="{{spotId || !visibleFeaturedGuides.length}}"
      type="album"
      title="{{spotId && activeChip === 'all' ? '该打卡点暂无相关灵感' : '该分类暂无旅拍灵感'}}"
      desc="{{spotId && activeChip === 'all' ? '换个打卡点，或看看其他拍摄服务。' : '换个分类，或看看其他拍摄服务。'}}"
      button-text="看打卡点"
      bind:action="goAllPackages"
    />
  </block>

  <lxm-empty-state
    wx:else
    type="album"
    title="{{spotId ? '该打卡点暂无相关灵感' : '旅拍灵感整理中'}}"
    desc="换个打卡点，或看看其他拍摄服务。"
    button-text="看打卡点"
    bind:action="goAllPackages"
  />
</view>
