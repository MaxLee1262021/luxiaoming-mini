.search-page {
  min-height: 100vh;
  padding-bottom: 56rpx;
  background: var(--lxm-c-bg);
  color: var(--lxm-c-ink);
}

.search-hero {
  padding: 18rpx 24rpx 20rpx;
  background:
    linear-gradient(135deg, rgba(255,211,106,0.34), rgba(255,211,106,0) 42%),
    linear-gradient(145deg, var(--lxm-c-gold-soft-2) 0%, var(--lxm-c-gold-soft) 58%, var(--lxm-c-gray-150) 100%);
}

.search-entry {
  height: 72rpx;
  padding: 0 10rpx 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.94);
  display: flex;
  align-items: center;
  box-shadow: 0 16rpx 34rpx rgba(238,44,44,0.10);
  border: 2rpx solid transparent;
  animation: searchBreath 2.8s ease-in-out infinite;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.search-entry.focused {
  border-color: var(--lxm-c-red);
  box-shadow: 0 18rpx 42rpx rgba(238,44,44,0.20);
}

.search-icon {
  margin-right: 12rpx;
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-lg);
  font-weight: 900;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-base);
  background: transparent;
}

.search-clear {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: rgba(42,33,27,0.22);
}

/* 无障碍：透明热区扩至 88rpx（WCAG 2.5.5） */
.search-clear::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 88rpx;
  height: 88rpx;
}

.search-clear:active {
  transform: scale(0.92);
  background: rgba(42,33,27,0.32);
}

@keyframes searchBreath {
  0%, 100% {
    box-shadow: 0 16rpx 34rpx rgba(238,44,44,0.10);
  }
  50% {
    box-shadow: 0 18rpx 42rpx rgba(238,44,44,0.18);
  }
}

.hot-wrap {
  margin-top: 16rpx;
}

.hot-title {
  display: block;
  color: rgba(42,33,27,0.68);
  font-size: var(--lxm-fz-sm);
  font-weight: 900;
}

.hot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.hot-chip {
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.72);
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-sm);
  font-weight: 900;
}

.section {
  margin-top: 28rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 0 30rpx;
  margin-bottom: 16rpx;
}

.section-title {
  display: block;
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-lg);
  font-weight: 900;
}

.section-sub {
  display: block;
  margin-top: 6rpx;
  color: var(--lxm-c-gray-700);
  font-size: var(--lxm-fz-sm);
}

.section-more {
  position: relative;
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-sm);
  font-weight: 900;
}

/* 无障碍：透明热区扩至 88rpx（WCAG 2.5.5） */
.section-more::after {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
  height: 88rpx;
}

/* 打卡点列表行：全站 Form A 统一规格（图片左 + 名称/简介右） */
.spot-card {
  display: flex;
  align-items: stretch;
  margin: 0 28rpx 16rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  background: var(--lxm-c-surface);
  box-shadow: 0 6rpx 18rpx rgba(64,39,26,0.06);
}

.spot-img,
.spot-cover {
  width: 180rpx;
  height: 150rpx;
  margin-right: 18rpx;
  border-radius: 20rpx;
  background: var(--lxm-c-gray-500);
  flex-shrink: 0;
}

.spot-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.spot-name {
  font-size: var(--lxm-fz-md);
  font-weight: 900;
  color: var(--lxm-c-ink);
}

.spot-desc {
  display: -webkit-box;
  margin-top: 8rpx;
  color: var(--lxm-c-gray-700);
  font-size: var(--lxm-fz-sm);
  line-height: 1.45;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.mini-tag {
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: var(--lxm-c-bg);
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-2xs);
  font-weight: 900;
}

.package-scroll,
.video-product-scroll {
  padding-left: 28rpx;
  white-space: nowrap;
}

/* 套餐卡横向滚动：直接命中 lxm-package-card，统一 320rpx 宽（与探索页一致，修复截断） */
.package-scroll lxm-package-card {
  display: inline-block;
  width: 320rpx;
  flex: 0 0 auto;
  margin-right: 20rpx;
  vertical-align: top;
}

.pkg-scroll-item {
  display: inline-block;
  width: 320rpx;
  margin-right: 18rpx;
  vertical-align: top;
}

/* 拍照攻略结果列表（纵向攻略卡） */
.guide-result-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 0 28rpx;
}

/* 约拍定制入口：排在相关结果最上方一排（按用户要求） */
.booking-top {
  margin: 8rpx 24rpx 4rpx;
}

