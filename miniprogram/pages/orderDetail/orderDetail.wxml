<view class="page">
  <lxm-nav-bar showBack="{{true}}" placeholder="{{false}}" />
  <lxm-privacy-modal />
  <lxm-toast id="lxmToast" />
  <view wx:if="{{loading}}" class="lxm-skeleton-wrap">
    <view class="lxm-skeleton lxm-skeleton-hero"></view>
    <view class="lxm-skeleton lxm-skeleton-block"></view>
    <view class="lxm-skeleton lxm-skeleton-block lxm-skeleton-block--short"></view>
  </view>

    <view class="state-page" wx:elif="{{error}}">
      <view class="state-title">{{error}}</view>
      <view class="state-desc">可返回"我的订单"重新进入，或联系客服协助查询。</view>
      <button class="state-btn" bindtap="retry">重新加载</button>
      <button class="state-btn state-contact-btn" bindtap="contactService">联系客服</button>
  </view>

  <view class="order-detail-page" wx:else>
    <view class="order-header">
      <view class="header-copy">
        <text class="header-kicker">订单详情</text>
        <text class="header-title">{{order.packageName}}</text>
        <text class="header-desc">{{statusDesc}}</text>
      </view>
      <view class="order-no-wrap" bindtap="copyOrderNo">
        <text class="order-no-label">订单编号</text>
        <text class="order-no">{{order.orderNo || order._id}}</text>
        <text class="copy-text">复制</text>
      </view>
      <view class="status-tag status-{{order.customerStatusKey || order.status}}">{{order.statusText}}</view>
    </view>

    <view class="progress-section" wx:if="{{order.customerStatusKey !== 'pending_payment' && order.customerStatusKey !== 'cancelled' && order.workflowStage !== 'cancelled' && !order.isAfterSale}}">
      <view class="progress-bar">
        <block wx:for="{{orderStatusFilters}}" wx:key="key">
          <view wx:if="{{index > 0}}" class="progress-line {{order.statusIndex >= index ? 'active' : ''}}"></view>
          <view class="progress-step {{order.statusIndex >= index ? 'active' : ''}} {{item.key === 'completed' && order.customerStatusKey === 'completed' ? 'done' : ''}}">
            <view class="step-dot">{{index + 1}}</view>
            <text class="step-label">{{item.text}}</text>
          </view>
        </block>
      </view>
      <view class="progress-desc">{{statusDesc}}</view>
      <view class="progress-actions" wx:if="{{order.customerStatusKey !== 'completed'}}">
        <button class="progress-action-btn" wx:if="{{order.canConfirmArrival}}" loading="{{arrivalSubmitting}}" disabled="{{arrivalConfirming || arrivalSubmitting}}" bindtap="confirmArrival">到达点位</button>
        <button class="progress-action-btn" wx:else disabled="{{true}}">{{order.customerArrivedAt ? '已到达点位' : '到达点位'}}</button>
        <button class="progress-action-btn" wx:if="{{order.canPayFinal}}" loading="{{paymentSubmitting}}" disabled="{{paymentSubmitting}}" bindtap="handlePaymentTap" data-phase="final">支付尾款</button>
        <button class="progress-action-btn" wx:elif="{{order.canConfirmCompletion}}" loading="{{paymentSubmitting}}" disabled="{{paymentSubmitting}}" bindtap="confirmCompletion">确认完成订单</button>
        <button class="progress-action-btn" wx:elif="{{paymentStatus === 'pending' && !order.canPay && order.paymentPhase === 'final' && !order.paymentReviewRequired}}" loading="{{paymentSubmitting}}" disabled="{{paymentSubmitting}}" bindtap="continueWechatPayment">支付尾款</button>
        <button class="progress-action-btn" wx:else disabled="{{true}}">支付尾款</button>
      </view>
      <view class="file-action-error" wx:if="{{order.canConfirmArrival && arrivalError}}">{{arrivalError}}</view>
      <view class="progress-payment" wx:if="{{order.canPayFinal || order.canConfirmCompletion || (paymentStatus === 'pending' && !order.canPay && order.paymentPhase === 'final' && order.customerStatusKey !== 'completed' && !order.paymentReviewRequired)}}">
        <view class="payment-row" wx:if="{{order.finalDue > 0}}"><text>本次应付尾款</text><text class="payment-amount">¥{{order.finalDue}}</text></view>
        <view class="payment-hint">{{order.canConfirmCompletion ? '本单无需支付尾款，请在拍摄完成后确认，确认后订单进入“已完成”。' : paymentMessage || '拍摄完成后请支付尾款。点击支付尾款即确认本次拍摄并同意支付尾款，到账后订单进入“已完成”。'}}</view>
      </view>
    </view>

    <view class="progress-section terminated" wx:elif="{{order.isAfterSale || order.customerStatusKey === 'cancelled' || order.workflowStage === 'cancelled'}}">
      <view class="terminated-tag {{order.isAfterSale ? 'aftersale' : 'canceled'}}">{{order.isAfterSale ? '售后处理中' : '订单已取消'}}</view>
      <view class="progress-desc">{{statusDesc}}</view>
    </view>

    <view class="info-card reservation-card">
      <view class="card-title">预约信息</view>
      <view class="info-row"><text>预约项目</text><text class="highlight">{{order.reservationInfo.projectName || '预约项目'}}{{order.reservationInfo.priceText ? ' ' + order.reservationInfo.priceText : ''}}</text></view>
      <view class="info-row"><text>拍摄点位</text><text>{{order.reservationInfo.spotNamesText || '暂无点位信息'}}</text></view>
      <view class="info-row" wx:if="{{order.reservationInfo.seriesName}}"><text>拍摄风格</text><text>{{order.reservationInfo.seriesName}}</text></view>
      <view class="info-row"><text>预约时间</text><text>{{order.reservationInfo.timeText || '未填写'}}</text></view>
      <view class="info-row"><text>类型</text><text>{{productTypeSummary || (order.type === 'video' ? '视频摄像' : '照片留影')}}</text></view>
      <view class="info-row"><text>姓名</text><text>{{order.reservationInfo.contactName || '未填写'}}</text></view>
      <view class="info-row"><text>手机</text><text>{{order.reservationInfo.contactPhone || '未填写'}}</text></view>
      <view class="info-row" wx:if="{{order.reservationInfo.contactWechat}}"><text>微信</text><text>{{order.reservationInfo.contactWechat}}</text></view>
      <view class="info-row"><text>预约备注</text><text class="reservation-note">{{order.reservationInfo.message || '未填写'}}</text></view>
    </view>

    <view class="info-card order-products-card" wx:if="{{productItemsDisplay.length}}">
      <view class="card-title">商品明细</view>
      <view class="order-products">
        <view class="order-product" wx:for="{{productItemsDisplay}}" wx:key="key" bindtap="goOrderProduct" data-index="{{index}}" hover-class="order-product--pressed">
          <view class="order-product__dot order-product__dot--{{item.typeClass}}"></view>
          <view class="order-product__main">
            <text class="order-product__name">{{item.name}}</text>
            <text class="order-product__meta">{{item.typeLabel}} · ×{{item.quantity}}</text>
            <text class="order-product__meta" wx:if="{{item.spotName || item.seriesName}}">{{item.spotName}}{{item.spotName && item.seriesName ? ' · ' : ''}}{{item.seriesName}}</text>
          </view>
          <view class="order-product__trailing">
            <text class="order-product__price" wx:if="{{item.priceText}}">{{item.priceText}}</text>
            <text class="order-product__arrow" wx:if="{{item.targetId}}">›</text>
          </view>
        </view>
      </view>
    </view>

    <view class="info-card" wx:if="{{physicalOrdersDisplay.length}}">
      <view class="card-title">套餐周边发货</view>
      <view class="deliver-desc">套餐周边通过实物订单发货，可查看发货进度、物流并确认收货。</view>
      <view wx:for="{{physicalOrdersDisplay}}" wx:key="id" wx:for-item="physicalOrder" wx:for-index="physicalIndex">
        <view class="info-row"><text>{{physicalOrder.orderNo || physicalOrder.id}}</text><text class="highlight">{{physicalOrder.statusText}}</text></view>
        <view class="deliver-desc" wx:for="{{physicalOrder.items}}" wx:key="id" wx:for-item="product">{{product.name}} {{product.spec}} ×{{product.quantity}}</view>
        <button class="deliver-btn" bindtap="openPhysicalOrder" data-index="{{physicalIndex}}">查看实物订单与物流</button>
      </view>
    </view>

    <view class="info-card amount-card">
      <view class="card-title">预约账单</view>
      <view class="info-row"><text>订单总额</text><text class="highlight">¥{{reservationBill.totalText}}</text></view>
      <view class="info-row"><text>已收定金</text><text>¥{{reservationBill.depositText}}</text></view>
      <view class="info-row"><text>待收尾款</text><text>¥{{reservationBill.balanceText}}</text></view>
      <view class="info-row"><text>已收尾款</text><text>¥{{reservationBill.finalPaidText}}</text></view>
      <view class="info-row"><text>已退款</text><text>{{reservationBill.refundedText === '—' ? '—' : '¥' + reservationBill.refundedText}}</text></view>
    </view>

    <view class="payment-card" wx:if="{{order.canPayDeposit}}">
      <view class="card-title">支付订金</view>
      <view class="payment-row"><text>本次应付订金</text><text class="payment-amount">¥{{order.depositDue}}</text></view>
      <view class="payment-hint">{{paymentMessage || '确认金额后可在微信内完成支付，支付结果将由服务端确认。'}}</view>
      <button class="payment-btn" loading="{{paymentSubmitting}}" disabled="{{paymentSubmitting}}" bindtap="handlePaymentTap" data-phase="deposit">{{paymentStatus === 'pending' ? '继续微信支付' : '支付订金'}}</button>
    </view>

    <view class="info-card selection-hint-card" wx:if="{{order.customerStatusKey === 'shooting' && !order.canPay && !order.canConfirmCompletion}}">
      <view class="card-title">{{order.shootingCompleted ? '拍摄已完成' : '拍摄进行中'}}</view>
      <view class="deliver-desc">{{order.shootingCompleted ? '拍摄已完成，等待尾款确认后完成订单。' : '拍摄完成后可支付尾款，确认本次拍摄并完成订单。'}}</view>
      <button class="deliver-btn" bindtap="retry">刷新订单状态</button>
    </view>

    <view class="payment-card payment-pending-card" wx:if="{{paymentStatus === 'pending' && !order.canPay && order.paymentPhase === 'deposit' && order.customerStatusKey !== 'completed' && order.customerStatusKey !== 'cancelled' && !order.isAfterSale && !order.paymentReviewRequired}}">
      <view class="card-title">支付处理中</view>
      <view class="payment-hint">微信支付结果正在确认，可继续支付或刷新状态。</view>
      <button class="payment-btn" loading="{{paymentSubmitting}}" disabled="{{paymentSubmitting}}" bindtap="continueWechatPayment">继续微信支付</button>
    </view>

    <view class="info-card timeline-card" wx:if="{{order.statusLogs && order.statusLogs.length}}">
      <view class="card-title">订单进度</view>
      <view class="timeline-row" wx:for="{{order.statusLogs}}" wx:key="index">
        <view class="timeline-dot"></view>
        <view class="timeline-copy"><text>{{item.action || item.note || '订单已更新'}}</text><text class="timeline-time">{{item.time || item.createTime}}</text></view>
      </view>
    </view>

    <view class="deliver-card" wx:if="{{order.deliveryVisible}}">
      <view class="card-title">成片交付</view>
      <view class="deliver-desc">已发布的成片可预览并保存到相册。</view>
      <view class="delivered-file" wx:for="{{deliveryFiles}}" wx:key="id">
        <view class="delivered-file-copy"><text class="file-kind">{{item.type === 'video' ? '视频' : '照片'}}</text><text>{{item.name}}</text></view>
        <view class="delivered-file-actions">
          <button size="mini" bindtap="previewOrderFile" data-index="{{index}}">预览</button>
          <button size="mini" bindtap="saveOrderFile" data-index="{{index}}" disabled="{{!!fileBusyId}}">保存到相册</button>
        </view>
      </view>
      <view class="deliver-desc" wx:if="{{!deliveryFiles.length}}">本单暂无线上成片，请联系客服获取交付信息。</view>
      <view class="file-download-progress" wx:if="{{fileBusyId}}"><text>下载中 {{fileProgress}}%</text><button size="mini" bindtap="cancelFileDownload">取消下载</button></view>
      <button class="deliver-btn" bindtap="contactService">去企业微信联系客服</button>
    </view>

    <view class="info-card" wx:if="{{order.rescheduleRequest}}">
      <view class="card-title">{{order.rescheduleStatusText || '改期记录'}}</view>
      <block wx:if="{{order.rescheduleRequest}}">
        <view class="info-row"><text>申请时间</text><text>{{order.rescheduleRequest.appointmentAt}} {{order.rescheduleRequest.timePeriod}}</text></view>
        <view class="deliver-desc">{{order.rescheduleRequest.reason}}</view>
        <view class="deliver-desc" wx:if="{{order.rescheduleRequest.reviewReason}}">处理说明：{{order.rescheduleRequest.reviewReason}}</view>
      </block>
      <view class="deliver-desc" wx:if="{{order.rescheduleRequest.status === 'pending'}}">申请已提交，后台同意后才会更改档期，审批前仍以原档期为准。</view>
    </view>
    <view class="info-card" wx:if="{{order.refundStatusText}}">
      <view class="card-title">退款进度</view>
      <view class="deliver-desc">{{order.refundStatusText}}</view>
      <view class="file-action-error" wx:if="{{refundRetryError}}">{{refundRetryError}}</view>
      <button class="deliver-btn" wx:if="{{order.canRetryCancelRefund}}" loading="{{refundRetrySubmitting}}" disabled="{{refundRetrySubmitting}}" bindtap="retryCancelRefund">刷新并重试退款</button>
    </view>
    <view class="info-card" wx:if="{{!order.canApplyRefund && order.canCancel}}">
      <view class="card-title">取消订单</view>
      <view class="deliver-desc">{{order.cancelRuleText || '订单定档前可随时取消，已支付款项将自动原路退款，到账以微信退款结果为准。'}}</view>
      <button class="cancel-order-btn" bindtap="openCancel">取消订单</button>
    </view>

    <view class="info-card" wx:if="{{afterSaleRecords.length}}">
      <view class="card-title">售后记录</view>
      <view class="deliver-desc" wx:if="{{afterSaleRecordsLoading}}">正在加载售后记录…</view>
      <view wx:if="{{afterSaleRecordsError}}"><text class="file-action-error">{{afterSaleRecordsError}}</text><button size="mini" bindtap="loadAfterSales">重新加载</button></view>
      <view class="after-sale-record" wx:for="{{afterSaleRecords}}" wx:key="id" wx:for-item="ticket" wx:for-index="ticketIndex">
        <view class="info-row"><text>{{ticket.type}}</text><text>{{ticket.customerVisibleStatus || ticket.status}}</text></view>
        <view class="deliver-desc">{{ticket.reason}}</view>
        <view class="deliver-desc">{{ticket.createdAt}}</view>
        <button class="evidence-preview" size="mini" wx:for="{{ticket.attachments}}" wx:key="id" bindtap="previewOrderFile" data-ticket="{{ticketIndex}}" data-index="{{index}}">查看凭证 {{index + 1}}</button>
      </view>
    </view>
    <view class="file-action-error" wx:if="{{fileActionError}}">{{fileActionError}}</view>

    <view class="footer-action">
      <button class="contact-btn" bindtap="contactService">去企业微信联系客服</button>
      <button class="booking-btn" bindtap="goBookingAgain">再约一单</button>
    </view>
  </view>
  <view wx:if="{{cancelVisible}}" class="after-sale-mask" catchtap="closeCancel">
    <view class="after-sale-panel" catchtap="stopPanelTap">
      <view class="after-sale-hd"><text class="after-sale-title">取消订单</text><button size="mini" disabled="{{cancelSubmitting}}" bindtap="closeCancel">关闭</button></view>
      <view class="after-sale-subtitle">定档前可取消订单。已支付款项将自动原路退款，到账以微信退款结果为准。</view>
      <textarea class="after-sale-textarea" value="{{cancelFormReason}}" maxlength="500" placeholder="请填写取消原因（至少 2 个字）" disabled="{{cancelSubmitting}}" bindinput="onCancelReason" />
      <view class="file-action-error" wx:if="{{cancelError}}">{{cancelError}}</view>
      <view class="after-sale-actions"><button class="after-sale-cancel" disabled="{{cancelSubmitting}}" bindtap="closeCancel">暂不取消</button><button class="cancel-order-submit" loading="{{cancelSubmitting}}" disabled="{{cancelSubmitting}}" bindtap="submitCancel">确认取消订单</button></view>
    </view>
  </view>
</view>
