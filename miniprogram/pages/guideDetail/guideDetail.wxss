.guide-detail-page {
  min-height: 100vh;
  background: var(--lxm-c-bg);
  padding-bottom: calc(150rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.note-gallery,
.note-cover {
  width: 100%;
  height: 421.875rpx;
  background: #f3eee8;
}

.note-media { display: block; width: 100%; height: 100%; }
.note-cover { display: block; }
.note-heading { margin: 24rpx 28rpx 0; }
.note-kicker { color: var(--lxm-c-red-ink); font-size: var(--lxm-fz-sm); }
.note-title { margin-top: 12rpx; font-size: 40rpx; font-weight: 800; line-height: 1.5; color: var(--lxm-c-ink); }
.note-meta { margin-top: 12rpx; font-size: var(--lxm-fz-xs); color: var(--lxm-c-muted); }

.spot-link {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 88rpx;
  margin: 24rpx 24rpx 0;
  padding: 16rpx;
  border-radius: var(--lxm-r-md);
  background: var(--lxm-c-surface);
  box-shadow: var(--lxm-shadow-card);
}

.spot-link-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--lxm-r-sm);
  flex-shrink: 0;
  background: var(--lxm-c-gray-400);
}

.spot-link-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.spot-link-label {
  color: var(--lxm-c-muted);
  font-size: var(--lxm-fz-xs);
}

.spot-link-name {
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-md);
  font-weight: 900;
  margin-top: 6rpx;
}

.spot-link-arrow {
  flex-shrink: 0;
}

.content-card {
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
  border-radius: var(--lxm-r-md);
  background: var(--lxm-c-surface);
  box-shadow: var(--lxm-shadow-card);
}

.content-para {
  color: var(--lxm-c-muted);
  font-size: var(--lxm-fz-base);
  line-height: 1.7;
  margin-bottom: 18rpx;
}

.content-para:last-child {
  margin-bottom: 0;
}

.content-rich-text {
  display: block;
  overflow-wrap: break-word;
  color: var(--lxm-c-ink);
  font-size: var(--lxm-fz-base);
  line-height: 1.8;
}

.content-image {
  display: block;
  width: 100%;
  margin: 16rpx 0;
  border-radius: var(--lxm-r-sm);
}

.content-video {
  display: block;
  width: 100%;
  height: 360rpx;
  margin: 16rpx 0;
  border-radius: var(--lxm-r-sm);
  background: #191919;
}

.attachment-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  margin: 20rpx 0;
  padding: 22rpx;
  border: 1rpx solid #e9e3db;
  border-radius: var(--lxm-r-sm);
  background: #faf8f5;
  text-align: left;
  line-height: 1.5;
}

.attachment-card::after { border: 0; }
.attachment-card-active { background: #f1ece5; }
.attachment-card[disabled] { color: inherit; background: #f7f5f1; }
.attachment-icon {
  flex-shrink: 0;
  padding: 16rpx 10rpx;
  border-radius: 8rpx;
  background: #eee4d6;
  color: var(--lxm-c-red-ink);
  font-size: var(--lxm-fz-xs);
}
.attachment-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.attachment-name { color: var(--lxm-c-ink); font-size: var(--lxm-fz-base); overflow-wrap: break-word; }
.attachment-meta { margin-top: 6rpx; color: var(--lxm-c-muted); font-size: var(--lxm-fz-xs); }
.attachment-arrow { flex-shrink: 0; color: var(--lxm-c-red-ink); font-size: 34rpx; }

.guide-actions--favorite-only {
  justify-content: center;
}

.guide-actions--favorite-only .lxm-foot-favorite {
  margin-right: 0;
}

.state {
  padding: 80rpx 40rpx;
  text-align: center;
  color: var(--lxm-c-muted);
}

.state-btn {
  margin-top: 24rpx;
  background: var(--lxm-gradient-primary);
  color: var(--lxm-c-surface);
  border-radius: 999rpx;
}
